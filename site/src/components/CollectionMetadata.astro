---
interface Props { count: number; latestDate?: string; sidebar?: boolean; }
const { count, latestDate, sidebar = false } = Astro.props;
const dateLabel = latestDate && new Intl.DateTimeFormat('en-GB', {
  day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC',
}).format(new Date(`${latestDate}T00:00:00Z`));
---

<p class:list={['collection-metadata', { sidebar }]}>
  <span>{count} {count === 1 ? 'article' : 'articles'}</span>
  {latestDate && <span>{!sidebar && ' · Latest activity '}<time datetime={latestDate} aria-label={`Latest activity: ${dateLabel}`}>{dateLabel}</time></span>}
</p>

<style>
  .collection-metadata { margin: .75rem 0 0; color: rgba(0, 0, 0, .6); font-size: calc(13px * var(--listing-scale)); font-weight: 400; line-height: 1.5; }
  .sidebar { display: flex; flex-wrap: wrap; gap: .5em 1em; margin: 0 0 calc(18px * var(--listing-scale)); font-size: calc(12px * var(--listing-scale)); line-height: 1.4; }
  .sidebar > :first-child { color: rgba(0, 0, 0, .8); font-weight: 600; }
  @media (min-width: 768px) {
    .sidebar { display: block; margin-top: calc(8px * var(--listing-scale)); margin-bottom: 0; }
    .sidebar > span { display: block; }
    .sidebar > :first-child { margin-bottom: calc(12px * var(--listing-scale)); }
  }
</style>
