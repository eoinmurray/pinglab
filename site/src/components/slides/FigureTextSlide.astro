---
import type { ImageMetadata } from 'astro';
import Slide from './Slide.astro';
import SlideMedia from './SlideMedia.astro';
interface Props {
  title: string;
  image: ImageMetadata | string;
  alt: string;
  figureSide?: 'left' | 'right';
  balance?: 'figure-wide' | 'equal' | 'text-wide';
  caption?: string;
  source?: string;
  density?: 'default' | 'compact';
  crop?: { top: number; bottom: number };
}
const { title, image, alt, figureSide = 'left', balance = 'figure-wide', caption, source, density = 'compact', crop } = Astro.props;
---
<Slide title={title} density={density} layout="figure-text">
  <div class:list={['figure-text-body', `figure-text--${balance}`, { 'figure-text--right': figureSide === 'right' }]}>
    <figure class="slide-figure">
      <SlideMedia image={image} alt={alt} crop={crop} />
      {(caption || source) && <figcaption>{caption}{caption && source && <br />}{source && <span class="slide-source">{source}</span>}</figcaption>}
    </figure>
    <div class="figure-text-explanation"><slot /></div>
  </div>
</Slide>
