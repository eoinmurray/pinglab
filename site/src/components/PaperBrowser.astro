---
import CollectionBrowser from './CollectionBrowser.astro';
import PapersList from './PapersList.astro';
import { getPaperCollections, paperCollectionLabel, paperCollectionDescription, type Paper } from '../lib/papers';
import { getPosts } from '../lib/posts';
import { collectionCounts } from '../lib/collections';

interface Props { papers: Paper[]; collection?: string; }
const { papers, collection } = Astro.props;
const collections = getPaperCollections(papers);
const posts = await getPosts();
const paperCounts = collectionCounts(papers);
---
<CollectionBrowser title={collection ? paperCollectionLabel(collection) : 'Papers'}
  defaultCollection={{ label: paperCollectionLabel('default'), description: paperCollectionDescription('default') }}
  allCount={posts.length} allPapersCount={papers.length} searchKind="papers"
  collections={collections.map(name => ({ id: name, label: paperCollectionLabel(name), description: paperCollectionDescription(name), count: paperCounts.get(name) ?? 0, active: name === collection }))}>
  <PapersList papers={papers} collection={collection} />
</CollectionBrowser>
