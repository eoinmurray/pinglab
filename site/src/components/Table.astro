---
import { unified } from '@astrojs/markdown-remark';
import remarkMath from 'remark-math';
import rehypeKatex from 'rehype-katex';
import { renderToString } from 'katex';
import { formatTableNumber } from '../lib/table-number.ts';

// Always display numeric quantities to two significant figures. For numbers inside
// authored strings, Markdown or math, use formatTableNumber before composing the cell.
// Identifiers such as seeds and run IDs stay exact and should be passed as strings.
type Cell = string | number | { math: string } | { markdown: string };
interface TableProps {
  headers: Cell[];
  rowHeaders?: boolean;
  caption?: string;
  number?: number | string;
  id?: string;
  label?: string;
}
type Group = { label: Cell; rows: Cell[][] };
type Props = TableProps & (
  | { rows: Cell[][]; groups?: never }
  | { groups: Group[]; rows?: never }
);
const { headers, rows, groups, rowHeaders = false, caption, number, id, label = 'Report table' } = Astro.props;
const hasCaption = Astro.slots.has('default') || Boolean(caption);
const Container = hasCaption ? 'figure' : 'div';
const validCell = (cell: unknown) => typeof cell === 'string'
  || (typeof cell === 'number' && Number.isFinite(cell))
  || (cell !== null && typeof cell === 'object' && Object.keys(cell).length === 1
    && (('math' in cell && typeof cell.math === 'string')
      || ('markdown' in cell && typeof cell.markdown === 'string')));
const validRows = (value: unknown): value is Cell[][] => Array.isArray(value) && value.length > 0
  && value.every(row => Array.isArray(row) && row.length === headers.length && row.every(validCell));
const grouped = groups !== undefined;
if (!Array.isArray(headers) || headers.length < 2 || !headers.every(validCell)
  || (grouped
    ? rows !== undefined || !Array.isArray(groups) || !groups.length
      || !groups.every(group => group !== null && typeof group === 'object'
        && validCell(group.label) && validRows(group.rows))
    : !validRows(rows))) {
  throw new Error('Table requires valid headers and either nonempty rows or nonempty groups with labels and rows; row widths must match headers');
}
const processor = unified({
  remarkPlugins: [remarkMath], rehypePlugins: [[rehypeKatex, { throwOnError: true }]], smartypants: false,
}).createRenderer({ syntaxHighlight: false });
// Rich cells are authored Markdown, rendered with the same mathematics plugins as the articles.
const renderCell = async (cell: Cell) => typeof cell === 'number' ? formatTableNumber(cell)
  : typeof cell === 'string' ? cell
  : 'math' in cell ? { html: renderToString(cell.math, { throwOnError: true }) }
  : { html: (await (await processor).render(cell.markdown)).code.replace(/^<p>([\s\S]*)<\/p>\s*$/, '$1') };
const headings = await Promise.all(headers.map(renderCell));
const sections = await Promise.all((groups ?? [{ rows: rows! }]).map(async group => ({
  label: 'label' in group ? await renderCell(group.label) : undefined,
  rows: await Promise.all(group.rows.map(row => Promise.all(row.map(renderCell)))),
})));
---
<Container class:list={['report-table', { 'l-body': hasCaption }]} id={id}>
<div class="source-table" tabindex="0" role="region" aria-label={label}>
  <table>
    <thead><tr>{headings.map(cell => <th scope="col">{typeof cell === 'object' ? <Fragment set:html={cell.html} /> : cell}</th>)}</tr></thead>
    {sections.map(section => <tbody class:list={{ 'table-group': grouped }}>
      {grouped && <tr class="group-heading">
        <th scope="rowgroup" colspan={headers.length}>
          {typeof section.label === 'object' ? <Fragment set:html={section.label.html} /> : section.label}
        </th>
      </tr>}
      {section.rows.map(row => <tr>
        {row.map((cell, index) => rowHeaders && index === 0
          ? <th scope="row">{typeof cell === 'object' ? <Fragment set:html={cell.html} /> : cell}</th>
          : <td>{typeof cell === 'object' ? <Fragment set:html={cell.html} /> : cell}</td>)}
      </tr>)}
    </tbody>)}
  </table>
</div>
{hasCaption && <figcaption>{number !== undefined && <><strong>Table {number}.</strong>{' '}</>}<slot>{caption}</slot></figcaption>}
</Container>
<style>
  .report-table { min-width: 0; }
  .report-table > figcaption > :global(:first-child) { margin-top: 0; }
  .report-table > figcaption > :global(:last-child) { margin-bottom: 0; }
  .source-table { min-width: 0; overflow-x: auto; }
  .source-table:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
  .source-table :global(table) {
    width: 100%;
    margin: 0;
    border-collapse: collapse;
    border: 1px solid rgb(var(--ink) / .22);
    font-size: .875em;
    line-height: 1.5;
    font-variant-numeric: tabular-nums;
  }
  .source-table :global(th), .source-table :global(td) {
    padding: .65em .85em;
    border: 1px solid rgb(var(--ink) / .22);
    font-size: inherit;
    text-align: left;
    vertical-align: top;
    overflow-wrap: anywhere;
  }
  .source-table :global(thead th),
  .source-table :global(th[scope="row"]),
  .group-heading > th { background: rgb(var(--ink) / .045); font-weight: 600; }
  .source-table :global(tr > th:not(:first-child)), .source-table :global(tr > td:not(:first-child)) { text-align: right; }
  .group-heading { break-after: avoid; }
</style>
