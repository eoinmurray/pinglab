<dialog class="figure-lightbox" aria-label="Enlarged figure">
  <button type="button" class="figure-lightbox-close" autofocus aria-label="Close enlarged figure">×</button>
  <img class="figure-lightbox-image" alt="" />
</dialog>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('.figure-lightbox')!;
  const image = dialog.querySelector<HTMLImageElement>('img')!;
  let opener: HTMLAnchorElement | null = null;

  document.addEventListener('click', (event) => {
    if (event.defaultPrevented || event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
    if (!(event.target instanceof Element)) return;
    const link = event.target.closest<HTMLAnchorElement>('figure a.figure-image');
    const source = link?.querySelector('img');
    if (!link || !source) return;

    event.preventDefault();
    opener = link;
    image.src = link.href;
    image.alt = source.alt;
    dialog.showModal();
    document.documentElement.classList.add('figure-lightbox-open');
  });

  // Clicking either the enlarged image or its surrounding backdrop closes it.
  dialog.addEventListener('click', () => dialog.close());
  dialog.addEventListener('close', () => {
    document.documentElement.classList.remove('figure-lightbox-open');
    image.removeAttribute('src');
    image.alt = '';
    opener?.focus({ preventScroll: true });
    opener = null;
  });
</script>

<style is:global>
  figure a.figure-image { cursor: zoom-in; }
  html.figure-lightbox-open { overflow: hidden; }
  dialog.figure-lightbox {
    position: fixed;
    inset: 0;
    box-sizing: border-box;
    width: 100vw;
    max-width: none;
    height: 100dvh;
    max-height: none;
    margin: 0;
    padding: 3vh 2vw;
    border: 0;
    background: transparent;
    cursor: zoom-out;
  }
  dialog.figure-lightbox[open] { display: grid; place-items: center; }
  dialog.figure-lightbox::backdrop { background: rgb(0 0 0 / .75); }
  .figure-lightbox-image {
    display: block;
    width: 100%;
    height: 100%;
    min-height: 0;
    object-fit: contain;
  }
  .figure-lightbox-close {
    position: absolute;
    top: .5rem;
    right: .5rem;
    width: 2.5rem;
    height: 2.5rem;
    border: 1px solid rgb(255 255 255 / .5);
    border-radius: 50%;
    background: rgb(0 0 0 / .65);
    color: white;
    font: 1.75rem/1 sans-serif;
    cursor: pointer;
  }
  .figure-lightbox-close:focus-visible { outline: 2px solid white; outline-offset: 3px; }
  @media print { dialog.figure-lightbox[open] { display: none; } }
</style>
