---
interface Props {
  title: string;
  allCount: number;
  allPapersCount: number;
  collections: { id: string; label: string; description?: string; count: number; active: boolean }[];
  searchKind?: 'articles' | 'papers';
  defaultCollection?: { label: string; description: string };
}
const { title, allCount, allPapersCount, searchKind = 'articles' } = Astro.props;
const collections = searchKind === 'papers' ? Astro.props.collections : [...Astro.props.collections].sort((a, b) => b.count - a.count);
const selectedCollections = collections.filter(item => item.active);
const showDefault = selectedCollections.length === 0;
const heading = showDefault ? Astro.props.defaultCollection?.label : selectedCollections.map(item => item.label).join(' · ');
const description = showDefault ? Astro.props.defaultCollection?.description : selectedCollections.map(item => item.description).filter(Boolean).join(' ');
---
<div class="base-grid">
  <div class="article-browser l-page">
    <div class="browser-articles">
      <nav class="browser-tabs" aria-label="Browse">
        <a href="/" aria-current={searchKind === 'articles' ? 'page' : undefined}>Articles ({allCount})</a>
        <a href="/papers" aria-current={searchKind === 'papers' ? 'page' : undefined}>Papers ({allPapersCount})</a>
      </nav>
      <header class="collection-heading" data-default-label={Astro.props.defaultCollection?.label ?? title} data-default-description={Astro.props.defaultCollection?.description ?? ''}>
        <div class="heading-content">
          <h1 data-collection-title>{heading ?? title}</h1>
          <p data-collection-description>{description}</p>
        </div>
        {[Astro.props.defaultCollection, ...collections].filter(Boolean).map(item => <div class="heading-size" aria-hidden="true">
          <strong>{item!.label}</strong>
          <p>{item!.description}</p>
        </div>)}
      </header>
      <div class="browser-search" role="search">
        <svg viewBox="0 0 20 20" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="8.5" cy="8.5" r="5.5" /><path d="m13 13 4 4" /></svg>
        <input type="search" placeholder={`Search ${searchKind}…`} aria-label={`Search ${searchKind}`} />
        <button class="browser-search-clear" type="button" aria-label={`Clear ${searchKind} search`} hidden>
          <svg viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="m4 4 8 8m0-8-8 8" /></svg>
        </button>
      </div>
      <div class="browser-collection-control">
      <details class="browser-collections">
        <summary>
          <span class="collection-selection">{collections.some(collection => collection.active) ? collections.find(collection => collection.active)?.label : 'All collections'}</span>
          <svg viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="m4 6 4 4 4-4" /></svg>
        </summary>
        <div class="collection-options">
          <button class="collections-clear" type="button">All collections</button>
          <fieldset>
            <legend class="visually-hidden">Filter by collection</legend>
            {collections.map(collection => <label>
              <input type="radio" name={`collection-${searchKind}`} value={collection.id} data-label={collection.label} data-description={collection.description} checked={collection.active} />
              <span>{collection.label} <span class="collection-count">({collection.count})</span></span>
            </label>)}
          </fieldset>
        </div>
      </details>
      <button class="collections-reset" type="button" aria-label="Clear selected collection" hidden={!collections.some(collection => collection.active)}>
        <svg viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="m4 4 8 8m0-8-8 8" /></svg>
      </button>
      </div>
      <slot />
      <p class="browser-search-status visually-hidden" role="status" aria-live="polite"></p>
    </div>
  </div>
</div>

<script>
  function setupCollectionBrowser() {
    document.querySelectorAll<HTMLElement>('.browser-articles').forEach(browser => {
      if (browser.dataset.initialized) return;
      browser.dataset.initialized = 'true';
      const search = browser.querySelector<HTMLInputElement>('.browser-search input')!;
      const status = browser.querySelector<HTMLElement>('.browser-search-status')!;
      const clear = browser.querySelector<HTMLButtonElement>('.browser-search-clear')!;
      const dropdown = browser.querySelector<HTMLDetailsElement>('.browser-collections')!;
      const summary = dropdown.querySelector('summary')!;
      const selection = dropdown.querySelector<HTMLElement>('.collection-selection')!;
      const resetCollections = browser.querySelector<HTMLButtonElement>('.collections-reset')!;
      const choices = [...dropdown.querySelectorAll<HTMLInputElement>('input[type="radio"]')];
      const normalize = (value: string) => value.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase();
      const entries = [...browser.querySelectorAll<HTMLElement>('.article-list > li')].map(row => ({
        row, text: normalize(row.dataset.search ?? row.textContent ?? ''), collections: JSON.parse(row.dataset.collections ?? '[]') as string[],
      }));
      function filter() {
        clear.hidden = search.value.length === 0;
        const words = normalize(search.value).trim().split(/\s+/).filter(Boolean);
        const selected = choices.filter(choice => choice.checked);
        resetCollections.hidden = selected.length === 0;
        selection.textContent = selected[0]?.dataset.label ?? 'All collections';
        const heading = browser.querySelector<HTMLElement>('.collection-heading');
        if (heading) {
          const showDefault = selected.length === 0;
          heading.querySelector<HTMLElement>('[data-collection-title]')!.textContent = showDefault
            ? heading.dataset.defaultLabel! : selected[0].dataset.label!;
          heading.querySelector<HTMLElement>('[data-collection-description]')!.textContent = showDefault
            ? heading.dataset.defaultDescription! : selected[0].dataset.description ?? '';
        }
        let matches = 0;
        for (const { row, text, collections } of entries) {
          row.hidden = !words.every(word => text.includes(word))
            || (selected.length > 0 && !selected.some(choice => collections.includes(choice.value)));
          if (!row.hidden) matches++;
        }
        const filtered = words.length > 0 || selected.length > 0;
        status.textContent = filtered ? (matches ? `${matches} ${matches === 1 ? 'result' : 'results'}` : 'No matches found. Try another search or collection.') : '';
        status.classList.toggle('visually-hidden', matches > 0 || !filtered);
      }
      search.addEventListener('input', filter);
      search.addEventListener('search', filter);
      clear.addEventListener('click', () => {
        search.value = '';
        filter();
        search.focus();
      });
      choices.forEach(choice => choice.addEventListener('change', filter));
      function clearCollections() {
        choices.forEach(choice => { choice.checked = false; });
        filter();
      }
      dropdown.querySelector('.collections-clear')!.addEventListener('click', clearCollections);
      resetCollections.addEventListener('click', () => {
        clearCollections();
        dropdown.open = false;
        summary.focus();
      });
      dropdown.addEventListener('keydown', event => {
        if (event.key === 'Escape') { dropdown.open = false; summary.focus(); }
      });
      document.addEventListener('click', event => {
        if (event.target instanceof Node && !dropdown.contains(event.target)) dropdown.open = false;
      });
      filter();
    });
  }
  setupCollectionBrowser();
  document.addEventListener('astro:page-load', setupCollectionBrowser);
</script>

<style>
  :global(html:has(.article-browser)) { scrollbar-gutter: stable; }
  .visually-hidden { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  .article-browser, :global(body:has(.article-browser) .site-header nav) { width: min(100%, var(--listing-width)); justify-self: center; min-width: 0; }
  .browser-articles { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 12px; align-items: start; }
  .browser-tabs { grid-column: 1 / -1; display: flex; gap: 20px; margin: 16px 0 4px; }
  .browser-tabs a { color: var(--listing-muted); font-size: 13px; text-decoration: none; }
  .browser-tabs a[aria-current="page"] { color: rgb(var(--ink)); font-weight: 600; }
  .browser-tabs a:hover { color: rgb(var(--ink)); }
  .browser-search,
  .browser-collections summary,
  .browser-articles :global(.posts-list-sort:not([hidden])) { background: var(--popup); }
  .browser-search { grid-column: 1 / -1; position: relative; box-sizing: border-box; width: 100%; height: 48px; border: 1px solid rgb(var(--ink) / .2); border-radius: 6px; color: rgb(var(--ink) / .6); font-size: 14px; line-height: 20px; }
  .browser-search > svg { position: absolute; left: 14px; top: 50%; transform: translateY(-50%); pointer-events: none; }
  .browser-search input { display: block; box-sizing: border-box; min-width: 0; width: 100%; height: 100%; padding: 12px 44px 12px 42px; border: 0; outline: none; background: transparent; color: rgb(var(--ink)); font: inherit; }
  .browser-search input::-webkit-search-cancel-button { -webkit-appearance: none; }
  .browser-search-clear { position: absolute; right: 6px; top: 50%; transform: translateY(-50%); display: flex; align-items: center; justify-content: center; width: 32px; height: 32px; padding: 0; border: 0; border-radius: 4px; background: transparent; color: rgb(var(--ink) / .6); cursor: pointer; }
  .browser-search-clear[hidden] { display: none; }
  .browser-search-clear:hover { color: rgb(var(--ink)); background: rgb(var(--ink) / .06); }
  .browser-search-clear:focus-visible { outline: 1px solid rgb(var(--ink) / .6); outline-offset: -2px; }
  .browser-search input::placeholder { color: rgb(var(--ink) / .6); opacity: 1; }
  .browser-search:hover, .browser-search:focus-within { border-color: rgb(var(--ink) / .4); }
  .browser-collection-control { grid-column: 1; position: relative; min-width: 0; }
  .browser-collections { position: relative; min-width: 0; font-size: 14px; }
  .browser-collection-control:has(.collections-reset:not([hidden])) .collection-selection { padding-right: 28px; }
  .collections-reset { position: absolute; right: 32px; top: 8px; display: flex; align-items: center; justify-content: center; width: 28px; height: 32px; padding: 0; border: 0; border-radius: 4px; background: transparent; color: rgb(var(--ink) / .6); cursor: pointer; }
  .collections-reset[hidden] { display: none; }
  .collections-reset:hover { color: rgb(var(--ink)); background: rgb(var(--ink) / .06); }
  .collections-reset:focus-visible { outline: 1px solid rgb(var(--ink) / .6); outline-offset: -2px; }
  .browser-collections summary { display: flex; align-items: center; justify-content: space-between; gap: 10px; box-sizing: border-box; height: 48px; padding: 0 14px; border: 1px solid rgb(var(--ink) / .2); border-radius: 6px; list-style: none; color: rgb(var(--ink) / .85); cursor: pointer; }
  .browser-collections summary::-webkit-details-marker { display: none; }
  .browser-collections summary:hover, .browser-collections summary:focus-visible { border-color: rgb(var(--ink) / .4); outline: none; }
  .collection-selection { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .collection-heading { grid-column: 1 / -1; display: grid; margin: 8px 0 12px; }
  .heading-content, .heading-size { grid-area: 1 / 1; min-width: 0; }
  .heading-size { visibility: hidden; pointer-events: none; }
  .collection-heading h1, .heading-size strong { display: block; font-weight: 700; margin: 0 0 10px; font-size: 28px; line-height: 1.25; }
  .collection-heading p { margin: 0; color: var(--listing-muted); font-size: 14px; line-height: 1.6; }
  .browser-collections summary svg { flex-shrink: 0; }
  .browser-collections[open] summary svg { transform: rotate(180deg); }
  .collection-options { position: absolute; top: calc(100% + 6px); left: 0; z-index: 20; width: min(320px, calc(100vw - 48px)); box-sizing: border-box; max-height: min(440px, 60dvh); overflow-y: auto; padding: 8px; border: 1px solid rgb(var(--ink) / .2); border-radius: 6px; background: var(--page); box-shadow: 0 6px 20px rgb(var(--ink) / .1); }
  .collection-options fieldset { border: 0; padding: 0; margin: 0; min-width: 0; }
  .collection-options label, .collections-clear { display: flex; align-items: center; gap: 10px; width: 100%; box-sizing: border-box; padding: 9px 8px; border: 0; border-radius: 4px; background: transparent; color: rgb(var(--ink) / .85); font: inherit; font-size: 13px; line-height: 1.5; text-align: left; cursor: pointer; }
  .collection-options label:hover, .collections-clear:hover { background: rgb(var(--ink) / .06); }
  .collection-options input { flex-shrink: 0; width: 16px; height: 16px; margin: 0; accent-color: rgb(var(--ink)); }
  .collection-count { color: var(--listing-muted); }
  .collections-clear { font-weight: 600; margin-bottom: 4px; }
  .browser-articles :global(.article-list > li[hidden]) { display: none; }
  .browser-articles :global(.article-list > li:nth-last-child(1 of :not([hidden]))) { border-bottom: none; }
  .browser-search-status { grid-column: 1 / -1; margin: 12px 0; color: var(--listing-muted); font-size: 14px; }
  .browser-articles :global(.base-grid) { display: contents; }
  .browser-articles :global(.article-list) { grid-column: 1 / -1; width: 100%; margin-top: 0; }
  .browser-articles :global(.posts-list-sort:not([hidden])) { grid-column: 2; box-sizing: border-box; width: auto; height: 48px; margin-top: 0; padding: 0 14px; gap: 8px; border: 1px solid rgb(var(--ink) / .2); border-radius: 6px; font-size: 14px; line-height: 20px; }
  .browser-articles :global(.posts-list-sort label), .browser-articles :global(.sort-selection) { font-size: 14px; }
  .browser-articles :global(.posts-list-sort select) { border-bottom: 0; }
  .browser-articles :global(.posts-list-sort:hover), .browser-articles :global(.posts-list-sort:focus-within) { border-color: rgb(var(--ink) / .4); }
  .browser-articles :global(.posts-list-sort select:focus-visible) { outline: none; }
  @media (min-width: 768px) {
    .browser-articles { grid-template-columns: minmax(0, 1fr) minmax(160px, 220px); }
    .browser-articles:has(:global(.posts-list-sort:not([hidden]))) { grid-template-columns: minmax(0, 1fr) minmax(160px, 200px) auto; }
    .collection-options { left: auto; right: 0; }
    .browser-search { grid-column: 1; grid-row: 2; }
    .browser-collection-control { grid-column: 2; grid-row: 2; }
    .browser-articles :global(.posts-list-sort:not([hidden])) { grid-column: 3; grid-row: 2; }
    .browser-articles:has(.collection-heading) .browser-search,
    .browser-articles:has(.collection-heading) .browser-collection-control,
    .browser-articles:has(.collection-heading) :global(.posts-list-sort:not([hidden])) { grid-row: 3; }
  }
  @media print { .browser-search, .browser-collection-control, .browser-tabs { display: none; } }
</style>
