---
import { getEntry } from 'astro:content';
import ArticleDate from './ArticleDate.astro';

interface Props {
  experiment: string;
  showDate?: boolean;
}

const { experiment, showDate = true } = Astro.props;
const report = await getEntry('reports', experiment);
if (!report) throw new Error(`ExperimentCard: unknown experiment "${experiment}"`);
---

<a class="experiment-card" href={`/${report.id}`}>
  <span class="experiment-card-id">{report.id}</span>
  <span class="experiment-card-content">
    <span class="experiment-card-title">{report.data.title}</span>
    {showDate && <span class="experiment-card-date">Updated <ArticleDate date={report.data.updated_at} compact showTime={false} /></span>}
  </span>
  <svg class="experiment-card-arrow" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
    <path d="M3 8h10m-4-4 4 4-4 4" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round" />
  </svg>
</a>

<style>
  .experiment-card {
    box-sizing: border-box;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: .875rem;
    min-width: 0;
    margin: 0 0 .75rem;
    padding: .75rem .875rem;
    border: 1px solid rgb(var(--ink) / .16);
    border-radius: 6px;
    background: var(--page);
    color: rgb(var(--ink) / .9);
    text-decoration: none;
    line-height: 1.4;
    break-inside: avoid;
  }
  .experiment-card:hover {
    border-color: rgb(var(--ink) / .4);
    background: var(--surface);
  }
  .experiment-card:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }
  .experiment-card-id {
    padding: .25rem .4rem;
    border-radius: 3px;
    background: rgb(var(--ink) / .06);
    color: var(--listing-label);
    font: 600 11px/1.4 ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    white-space: nowrap;
  }
  .experiment-card-content { min-width: 0; }
  .experiment-card-title {
    display: block;
    font-size: 15px;
    font-weight: 600;
    overflow-wrap: anywhere;
  }
  .experiment-card-date {
    display: block;
    margin-top: 3px;
    color: var(--listing-muted);
    font-size: 12px;
  }
  .experiment-card-arrow { color: var(--listing-muted); }
  @media (max-width: 480px) {
    .experiment-card { gap: .625rem; padding: .625rem .75rem; }
    .experiment-card-id { align-self: start; }
  }
</style>
