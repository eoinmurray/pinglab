---
import { runWalltime, dataSize } from '../lib/run-metrics';
import type { dataset } from '../lib/pingstore';
interface Props { runs: Awaited<ReturnType<typeof dataset>>['runs']; label: string; }
const { runs, label } = Astro.props;
---
<div class="table-scroll" tabindex="0" role="region" aria-label={label}>
  <table>
    <thead><tr><th>Run</th><th>Date</th><th>Duration</th><th>Size</th><th>Storage</th><th>Depends on</th></tr></thead>
    <tbody>{runs.map(({ id, record, evidence, used }) => <tr class:list={{ 'selected-run': used }}>
      <td title={record.description}>{id}</td>
      <td><time datetime={record.created_at}>{record.created_at.slice(0, 16).replace('T', ' ')}</time></td>
      <td>{runWalltime(record)}</td><td>{dataSize(evidence?.bytes)}</td><td>{evidence?.storage ?? '—'}</td>
      <td>{record.depends_on.join(', ') || '—'}</td>
    </tr>)}</tbody>
  </table>
</div>
<style>
  .table-scroll { overflow-x: auto; }
  table { width: 100%; border-collapse: collapse; font-size: inherit; }
  th, td { text-align: left; padding: .6em .65em; border-bottom: 1px solid rgb(var(--ink) / .1); white-space: nowrap; }
  .selected-run { background: rgb(var(--ink) / .05); }
</style>
