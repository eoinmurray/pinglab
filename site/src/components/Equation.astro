---
import NativeMath from './NativeMath.astro';
interface Props { markup: string; id: string; number: string; }
const { markup, id, number } = Astro.props;
---
<div class="numbered-equation" id={id}>
  <div class="equation-body"><NativeMath markup={markup} /></div>
  <span>({number})</span>
</div>
<style>
  .numbered-equation { display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: center; gap: 1em; margin: 1.5rem 0; }
  .equation-body { min-width: 0; overflow-x: auto; overflow-y: hidden; }
</style>
