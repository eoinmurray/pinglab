---
import type { Post } from '../lib/posts';
import { collectionUrl, collectionLabel } from '../lib/collections';

interface Props { posts: Post[]; }
const { posts } = Astro.props;
const dateLabel = (date: string) => new Intl.DateTimeFormat('en-GB', {
  day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC',
}).format(new Date(`${date}T00:00:00Z`));
---

<div class="base-grid">
  <ol class="posts-list article-list listing-width l-page" role="list">
    {posts.map((report) => (
      <li class="post-preview article-list-row">
        <div class="metadata">
          <a class="experiment-id" href={report.href} aria-label={`Open ${report.data.title}`}>{report.label}</a>
          <div class="publishedDate"><time datetime={report.data.updated_at}>{dateLabel(report.data.updated_at)}</time></div>
          <div class="collection">{report.collections.map(collection => <a class="collection-badge" href={collectionUrl(collection)}>{collectionLabel(collection)}</a>)}</div>
        </div>
        <a class="post-link article-list-content" href={report.href}>
          <div class="description">
            <h2 class="title article-list-title">{report.data.title}</h2>
            <p class="authors">{report.data.author}</p>
            <p class="abstract article-list-description">{report.data.description}</p>
          </div>
        </a>
      </li>
    ))}
  </ol>
  </div>

<style>
  .post-preview { overflow: hidden; }
  .post-link { color: inherit; text-decoration: none; }
  .post-link:focus-visible { outline: 2px solid #004276; outline-offset: 6px; }
  .description .authors { font-size: calc(14px * var(--listing-scale)); margin: 0 0 1em; color: rgba(0, 0, 0, .67); line-height: 1.4; }
  .metadata { font-size: calc(12px * var(--listing-scale)); line-height: 1.4; margin-bottom: calc(18px * var(--listing-scale)); }
  .experiment-id { display: inline-block; margin-right: 1em; color: rgba(0, 0, 0, .8); font-size: calc(18px * var(--listing-scale)); font-weight: 600; text-decoration: none; }
  .experiment-id:hover { text-decoration: underline; }
  .publishedDate { display: inline-block; margin-right: 1em; }
  .collection { display: inline-flex; flex-wrap: wrap; gap: .5em; margin-top: 1em; }
  .collection-badge { color: rgba(0, 0, 0, .67); padding: .3em .5em; border: 1px solid rgba(0, 0, 0, .4); border-radius: 3px; text-transform: uppercase; font-size: 80%; font-weight: 500; text-decoration: none; }
  .collection-badge:hover { color: black; border-color: black; }
  @media (min-width: 768px) {
    .metadata { margin-top: calc(8px * var(--listing-scale)); margin-bottom: 0; }
    .experiment-id { display: block; margin: 0 0 calc(12px * var(--listing-scale)); }
    .publishedDate { display: block; }
    .collection { display: flex; }
    .description .authors { line-height: 1.5; }
  }
</style>
