---
import type { Post } from '../lib/posts';
import { collectionUrl, collectionLabel } from '../lib/collections';
import ArticleMetrics from './ArticleMetrics.astro';
import { articleMetrics } from '../lib/article-metrics';

interface Props { posts: Post[]; }
const { posts } = Astro.props;
const previews = await Promise.all(posts.map(async report => ({ report, counts: report.article ? await articleMetrics(report.article) : undefined })));
const dateLabel = (date: string) => new Intl.DateTimeFormat('en-GB', {
  day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC',
}).format(new Date(`${date}T00:00:00Z`));
---

<div class="base-grid">
  <ol class="posts-list article-list listing-width l-page" role="list">
    {previews.map(({ report, counts }) => (
      <li class="post-preview article-list-row">
        <div class="metadata">
          <a class="experiment-id" href={report.href} aria-label={`Open ${report.data.title}`}>{report.label}</a>
          <div class="publishedDate"><time datetime={report.data.updated_at}>{dateLabel(report.data.updated_at)}</time></div>
        </div>
        <div class="article-list-content">
          <a class="post-link" href={report.href}>
            <h2 class="title article-list-title">{report.data.title}</h2>
          </a>
          <div class="collection">{report.collections.map(collection => <a class="collection-badge" href={collectionUrl(collection)}>{collectionLabel(collection)}</a>)}{counts && <ArticleMetrics counts={counts} />}</div>
        </div>
      </li>
    ))}
  </ol>
  </div>

<style>
  .post-preview { overflow: hidden; }
  .post-link { display: block; color: inherit; text-decoration: none; }
  .post-link:focus-visible { outline: 2px solid var(--accent); outline-offset: 6px; }
  .metadata { font-size: calc(12px * var(--listing-scale)); line-height: 1.4; margin-bottom: calc(18px * var(--listing-scale)); }
  .experiment-id { display: inline-block; margin-right: 1em; color: var(--listing-label); font-size: calc(18px * var(--listing-scale)); font-weight: 600; text-decoration: none; }
  .experiment-id:hover { text-decoration: underline; }
  .publishedDate { display: inline-block; margin-right: 1em; }
  .collection { display: flex; align-items: center; flex-wrap: wrap; gap: .5em 1em; margin-top: calc(12px * var(--listing-scale)); font-size: calc(12px * var(--listing-scale)); line-height: 1.4; }
  .collection-badge { color: var(--listing-muted); padding: .3em .5em; border: 1px solid var(--listing-border); border-radius: 3px; text-transform: uppercase; font-size: 80%; font-weight: 500; text-decoration: none; }
  .collection-badge:hover { color: rgb(var(--ink)); border-color: rgb(var(--ink)); }
  @media (min-width: 768px) {
    .metadata { margin-top: calc(8px * var(--listing-scale)); margin-bottom: 0; }
    .experiment-id { display: block; margin: 0 0 calc(12px * var(--listing-scale)); }
    .publishedDate { display: block; }
  }
</style>
