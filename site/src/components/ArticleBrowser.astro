---
import PostsList from './PostsList.astro';
import CollectionBrowser from './CollectionBrowser.astro';
import type { Post } from '../lib/posts';
import { collectionCounts, collectionLabel, collectionDescription, compareCollections } from '../lib/collections';
import { getPapers, type Paper } from '../lib/papers';

interface Props { posts: Post[]; collection?: string; papers?: Paper[]; sortable?: boolean; }
const { posts, collection, papers = await getPapers(), sortable = false } = Astro.props;
const articleCounts = collectionCounts(posts);
const collections = [...new Set(posts.flatMap(post => post.collections))].sort(compareCollections);
const visiblePosts = [...posts];
visiblePosts.sort((a, b) => {
  const aExperiment = a.collections.includes('experiments');
  const bExperiment = b.collections.includes('experiments');
  return Number(bExperiment) - Number(aExperiment)
    || (aExperiment && bExperiment ? b.id.localeCompare(a.id, 'en', { numeric: true }) : 0);
});
---
<CollectionBrowser title={collection ? collectionLabel(collection) : 'Articles'}
  defaultCollection={{ label: 'Articles', description: 'Scientific reports, notes, and slide decks from Pinglab.' }}
  allCount={posts.length} allPapersCount={papers.length}
  collections={collections.map(name => ({ id: name, label: collectionLabel(name), description: collectionDescription(name), count: articleCounts.get(name) ?? 0, active: name === collection }))}>
  <PostsList posts={visiblePosts} sortable={sortable} collection={collection} />
</CollectionBrowser>
