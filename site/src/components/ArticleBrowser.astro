---
import PostsList from './PostsList.astro';
import CollectionBrowser from './CollectionBrowser.astro';
import type { Post } from '../lib/posts';
import { collectionLabel, collectionUrl, compareCollections } from '../lib/collections';
import { getPapers, getPaperCollections, paperCollectionLabel, paperCollectionUrl, type Paper } from '../lib/papers';

interface Props { posts: Post[]; collection?: string; papers?: Paper[]; }
const { posts, collection, papers = await getPapers() } = Astro.props;
const collections = [...new Set(posts.flatMap(post => post.collections))].sort(compareCollections);
const visiblePosts = collection ? posts.filter(post => post.collections.includes(collection)) : posts;
---
<CollectionBrowser title={collection ? collectionLabel(collection) : 'Articles'} allHref="/" allLabel="All articles"
  heading="Articles"
  literature={getPaperCollections(papers).map(name => ({ href: paperCollectionUrl(name), label: paperCollectionLabel(name) }))}
  filtered={!!collection} collections={collections.map(name => ({ href: collectionUrl(name), label: collectionLabel(name), active: name === collection }))}>
  <PostsList posts={visiblePosts} />
</CollectionBrowser>
