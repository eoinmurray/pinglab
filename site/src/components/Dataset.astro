---
import { getReports } from '../lib/reports';
import { dependencies, downstream } from '../lib/dependencies';
import { dataset } from '../lib/pingstore';

interface Props { experiment: string; selectedRuns?: Record<string, string>; }
const { experiment, selectedRuns } = Astro.props;
const inputs: [string, string | undefined][] = selectedRuns ? Object.entries(selectedRuns) : [[experiment, undefined]];
const datasets = await Promise.all(inputs.map(([id, runId]) => dataset(id, runId)));
const runs = [...new Map(datasets.flatMap(data => data.runs).map(run => [run.id, run])).values()];
const upstream = [...new Set([...(dependencies[experiment] ?? []), ...datasets.flatMap(data => data.upstream), ...Object.keys(selectedRuns ?? {}).filter(id => id !== experiment)])].sort();

const displayRuns = runs.map(run => ({
  ...run,
  timing: run.record.scientific_execution ?? run.record.completed_hpc_import?.source_execution
    ?? (run.record.execution.operation?.includes('import') ? undefined : run.record.execution),
  executionOrigin: run.record.scientific_execution?.origin ?? run.record.completed_hpc_import?.source_origin
    ?? (run.record.execution.operation?.includes('import') ? 'unknown' : run.record.origin),
}));
const entries = await getReports();
const dependents = [...new Set([...downstream(experiment), ...entries.filter(entry => entry.id !== experiment && entry.data.runs?.[experiment]).map(entry => entry.id)])].sort();
const reports = new Set(entries.map(report => report.id));
const titles = new Map(entries.map(report => [report.id, report.data.title]));
const experimentUrl = (id: string) => reports.has(id) ? `/${id}` : `https://pl.eoinmurray.info/${id}/`;
const date = new Intl.DateTimeFormat('en-GB', {
  day: 'numeric', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit', timeZone: 'UTC',
});
function size(bytes: number) {
  for (const [scale, unit] of [[1e12, 'TB'], [1e9, 'GB'], [1e6, 'MB'], [1e3, 'KB']] as const) {
    if (bytes >= scale) return `${Number((bytes / scale).toFixed(1))} ${unit}`;
  }
  return `${bytes} ${bytes === 1 ? 'byte' : 'bytes'}`;
}
function duration(start: string, end: string) {
  let seconds = Math.round((Date.parse(end) - Date.parse(start)) / 1000);
  if (seconds < 1) return '<1s';
  const parts: string[] = [];
  for (const [scale, unit] of [[86400, 'd'], [3600, 'h'], [60, 'm'], [1, 's']] as const) {
    const count = Math.floor(seconds / scale);
    if (count) parts.push(`${count}${unit}`);
    seconds %= scale;
  }
  return parts.join(' ');
}
function origin(value: string) {
  if (value === 'hpc' || value.startsWith('slurm')) return 'HPC';
  return ({ local: 'Local', mixed: 'Mixed', modal: 'Modal' } as Record<string, string>)[value] ?? 'Unknown';
}
---

  <h3 id="dataset">Dataset</h3>
  <section class="dataset" aria-labelledby="dataset">
    <p>{runs.length === 0 ? 'No presentation is selected for this report. ' : ''}{runs.length > 0 && <>Figures use the {selectedRuns ? 'recorded presentation selections' : 'latest presentation run'} and their same-experiment inputs. The table includes completed run history; the presentation used by this report is emphasized. Dates are run creation times in UTC; durations cover each stage separately, and sizes cover its exported files. For imported runs, durations and execution locations refer to the recorded producing execution.</>}</p>
    <p>Upstream: {upstream.length ? upstream.map((id, index) => <>{index > 0 && ', '}<a href={experimentUrl(id)}>{id}</a> — <a href={experimentUrl(id)}><em>{titles.get(id) ?? id}</em></a></>) : '—'}</p>
    <p>Downstream: {dependents.length ? dependents.map((id, index) => <>{index > 0 && ', '}<a href={experimentUrl(id)}>{id}</a> — <a href={experimentUrl(id)}><em>{titles.get(id) ?? id}</em></a></>) : '—'}</p>
    <div class="table-scroll" tabindex="0" role="region" aria-label="Dataset runs">
      <table>
        <thead><tr><th scope="col">Run</th><th scope="col">Date</th><th scope="col">Duration</th><th scope="col">Size</th><th scope="col">Ran on</th></tr></thead>
        <tbody>{displayRuns.map(({ id, record, bytes, selected, timing, executionOrigin }) => <tr>
          <td><span class:list={{ selected }} title={selected ? 'Presentation used by this report' : record.stage}>{id}</span></td>
          <td><time datetime={record.created_at}>{date.format(new Date(record.created_at))}</time></td>
          <td title="Recorded producing execution time for this stage; excludes upstream runs and import time">{timing ? duration(timing.started_at, timing.completed_at) : '—'}</td>
          <td title={`${bytes} bytes`}>{size(bytes)}</td>
          <td>{origin(executionOrigin)}</td>
        </tr>)}</tbody>
      </table>
    </div>
  </section>

<style>
  .dataset { min-width: 0; }
  p:first-child { margin-top: 0; }
  .table-scroll { overflow-x: auto; }
  table { width: 100%; border-collapse: collapse; font-size: inherit; line-height: inherit; }
  th, td { text-align: left; padding: .6em .65em; border-bottom: 1px solid rgba(0, 0, 0, .1); white-space: nowrap; }
  th:first-child, td:first-child { padding-left: 0; }
  th:last-child, td:last-child { padding-right: 0; }
  th, .selected { font-weight: 600; }
</style>
