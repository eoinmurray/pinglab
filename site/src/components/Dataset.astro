---
import { getReports } from '../lib/reports';
import { getCollection } from 'astro:content';
import { dependencies, downstream } from '../lib/dependencies';
import { dataset } from '../lib/pingstore';
import DatasetRuns from './DatasetRuns.astro';

interface Props { experiment: string; inputs?: string[]; includeEvidence?: boolean; headingId?: string; datasets?: Awaited<ReturnType<typeof dataset>>[]; }
const { experiment, includeEvidence = true, headingId = 'dataset' } = Astro.props;
const entries = await getReports();
const notes = (await getCollection('notes')).filter(note => note.data.inputs.length > 0);
const sourceExperiments = [...new Set([experiment, ...(Astro.props.inputs ?? entries.find(entry => entry.id === experiment)?.data.inputs ?? [])])];
const datasets = Astro.props.datasets ?? (includeEvidence ? await Promise.all(sourceExperiments.map(id => dataset(id))) : []);
const runMap = new Map<string, (typeof datasets)[number]['runs'][number]>();
for (const run of datasets.flatMap(data => data.runs)) {
  const previous = runMap.get(run.id);
  runMap.set(run.id, { ...run, selected: run.selected || !!previous?.selected, used: run.used || !!previous?.used });
}
const runs = [...runMap.values()].sort((a, b) => Date.parse(b.record.created_at) - Date.parse(a.record.created_at) || b.id.localeCompare(a.id));
const upstream = [...new Set([...(dependencies[experiment] ?? []), ...datasets.flatMap(data => data.upstream), ...sourceExperiments.filter(id => id !== experiment)])].sort();

const currentRuns = runs.filter(run => run.used);
const otherRuns = runs.filter(run => !run.used);
const dependents = [...new Set([
  ...downstream(experiment),
  ...entries.filter(entry => entry.id !== experiment && entry.data.inputs.includes(experiment)).map(entry => entry.id),
  ...notes.filter(note => note.data.presentation !== experiment && note.data.inputs.includes(experiment)).map(note => `notes/${note.id}`),
].map(id => notes.find(note => note.data.presentation === id) ? `notes/${notes.find(note => note.data.presentation === id)!.id}` : id))].sort();
const reports = new Set(entries.map(report => report.id));
const titles = new Map(entries.map(report => [report.id, report.data.title]));
for (const note of notes) titles.set(`notes/${note.id}`, note.data.title);
const experimentUrl = (id: string) => reports.has(id) || titles.has(id) ? `/${id}` : `https://pl.eoinmurray.info/${id}/`;
---

  <h3 id={headingId}>Dataset</h3>
  <section class="dataset" aria-labelledby={headingId}>
    {runs.length === 0 && <p>No completed runs are available for this selection.</p>}
    <p>Upstream: {upstream.length ? upstream.map((id, index) => <>{index > 0 && ', '}<a href={experimentUrl(id)}>{id}</a> — <a href={experimentUrl(id)}><em>{titles.get(id) ?? id}</em></a></>) : '—'}</p>
    <p>Downstream: {dependents.length ? dependents.map((id, index) => <>{index > 0 && ', '}<a href={experimentUrl(id)}>{id}</a> — <a href={experimentUrl(id)}><em>{titles.get(id) ?? id}</em></a></>) : '—'}</p>
    {currentRuns.length > 0 && <>
      <h4>Report dependencies</h4>
      <DatasetRuns runs={currentRuns} label="Report dependencies" />
    </>}
    {otherRuns.length > 0 && <details open={currentRuns.length === 0}>
      <summary>Other stored runs ({otherRuns.length})</summary>
      <p>These runs are outside this experiment's current runset. They are kept until explicitly deleted.</p>
      <DatasetRuns runs={otherRuns} label="Other stored runs" />
    </details>}
  </section>

<style>
  .dataset { min-width: 0; }
  p:first-child { margin-top: 0; }
  h4 { margin-bottom: .5em; }
  details { margin-top: 1.25em; }
  summary { cursor: pointer; }
</style>
