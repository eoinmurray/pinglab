---
import { getReports } from '../lib/reports';
import { dependencies, downstream } from '../lib/dependencies';
import { dataset } from '../lib/pingstore';

interface Props { experiment: string; includeEvidence?: boolean; headingId?: string; datasets?: Awaited<ReturnType<typeof dataset>>[]; }
const { experiment, includeEvidence = true, headingId = 'dataset' } = Astro.props;
const entries = await getReports();
const sourceExperiments = [...new Set([experiment, ...(entries.find(entry => entry.id === experiment)?.data.inputs ?? [])])];
const datasets = Astro.props.datasets ?? (includeEvidence ? await Promise.all(sourceExperiments.map(id => dataset(id))) : []);
const runMap = new Map<string, (typeof datasets)[number]['runs'][number]>();
for (const run of datasets.flatMap(data => data.runs)) {
  const previous = runMap.get(run.id);
  runMap.set(run.id, { ...run, selected: run.selected || !!previous?.selected, used: run.used || !!previous?.used });
}
const runs = [...runMap.values()].sort((a, b) => Date.parse(b.record.created_at) - Date.parse(a.record.created_at) || b.id.localeCompare(a.id));
const upstream = [...new Set([...(dependencies[experiment] ?? []), ...datasets.flatMap(data => data.upstream), ...sourceExperiments.filter(id => id !== experiment)])].sort();

const displayRuns = await Promise.all(runs.map(async run => {
  return {
  ...run,
  timing: run.record.scientific_execution ?? run.record.completed_hpc_import?.source_execution
    ?? (run.record.execution.operation?.includes('import') ? undefined : run.record.execution),
  executionOrigin: run.record.scientific_execution?.origin ?? run.record.completed_hpc_import?.source_origin
    ?? (run.record.execution.operation?.includes('import') ? 'unknown' : run.record.origin),
  };
}));
const dependents = [...new Set([...downstream(experiment), ...entries.filter(entry => entry.id !== experiment && entry.data.inputs.includes(experiment)).map(entry => entry.id)])].sort();
const reports = new Set(entries.map(report => report.id));
const titles = new Map(entries.map(report => [report.id, report.data.title]));
const experimentUrl = (id: string) => reports.has(id) ? `/${id}` : `https://pl.eoinmurray.info/${id}/`;
const date = new Intl.DateTimeFormat('en-GB', {
  day: 'numeric', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit', timeZone: 'UTC',
});
function size(bytes: number) {
  for (const [scale, unit] of [[1e12, 'TB'], [1e9, 'GB'], [1e6, 'MB'], [1e3, 'KB']] as const) {
    if (bytes >= scale) return `${Number((bytes / scale).toFixed(1))} ${unit}`;
  }
  return `${bytes} ${bytes === 1 ? 'byte' : 'bytes'}`;
}
function duration(start: string, end: string) {
  let seconds = Math.round((Date.parse(end) - Date.parse(start)) / 1000);
  if (seconds < 1) return '<1s';
  const parts: string[] = [];
  for (const [scale, unit] of [[86400, 'd'], [3600, 'h'], [60, 'm'], [1, 's']] as const) {
    const count = Math.floor(seconds / scale);
    if (count) parts.push(`${count}${unit}`);
    seconds %= scale;
  }
  return parts.join(' ');
}
function origin(value: string) {
  if (value === 'hpc' || value.startsWith('slurm')) return 'HPC';
  return ({ local: 'Local', mixed: 'Mixed', modal: 'Modal' } as Record<string, string>)[value] ?? 'Unknown';
}
---

  <h3 id={headingId}>Dataset</h3>
  <section class="dataset" aria-labelledby={headingId}>
    {runs.length === 0 && <p>No completed runs are available for this selection.</p>}
    <p>Upstream: {upstream.length ? upstream.map((id, index) => <>{index > 0 && ', '}<a href={experimentUrl(id)}>{id}</a> — <a href={experimentUrl(id)}><em>{titles.get(id) ?? id}</em></a></>) : '—'}</p>
    <p>Downstream: {dependents.length ? dependents.map((id, index) => <>{index > 0 && ', '}<a href={experimentUrl(id)}>{id}</a> — <a href={experimentUrl(id)}><em>{titles.get(id) ?? id}</em></a></>) : '—'}</p>
    <div class="table-scroll" tabindex="0" role="region" aria-label="Dataset runs">
      <table>
        <thead><tr><th scope="col">Run</th><th scope="col">Date</th><th scope="col">Duration</th><th scope="col">Size</th><th scope="col">Evidence</th><th scope="col">Storage</th><th scope="col">Ran on</th><th scope="col">Verification</th></tr></thead>
        <tbody>{displayRuns.map(({ id, record, bytes, selected, used, evidence, timing, executionOrigin }) => <tr class:list={{ 'selected-run': evidence.status === 'Current' }}>
          <td><span class:list={{ selected: used }} title={selected ? 'Presentation used by this report' : used ? 'Input run used to generate this report' : record.stage}>{id}</span></td>
          <td><time datetime={record.created_at}>{date.format(new Date(record.created_at))}</time></td>
          <td title="Recorded producing execution time for this stage; excludes upstream runs and import time">{timing ? duration(timing.started_at, timing.completed_at) : '—'}</td>
          <td title={`${bytes} bytes`}>{size(bytes)}</td>
          <td title={[...evidence.reasons, ...evidence.unresolved].join('; ')}>{evidence.status}{evidence.status === 'Required' && ` by ${evidence.reasons.join(', ')}`}</td>
          <td title={!evidence.verification || evidence.verification.r2 === 'unknown' ? 'R2 inventory unresolved' : undefined}>{evidence.storage}{evidence.verification.r2 === 'unknown' && ' (R2 unresolved)'}</td>
          <td>{origin(executionOrigin)}</td>
          <td title={evidence.unresolved.join('; ')}>{`Local: ${evidence.verification.local}; R2: ${evidence.verification.r2}`}</td>
        </tr>)}</tbody>
      </table>
    </div>
  </section>

<style>
  .dataset { min-width: 0; }
  p:first-child { margin-top: 0; }
  .table-scroll { overflow-x: auto; }
  table { width: 100%; border-collapse: collapse; font-size: inherit; line-height: inherit; }
  th, td { text-align: left; padding: .6em .65em; border-bottom: 1px solid rgb(var(--ink) / .1); white-space: nowrap; }
  th:last-child, td:last-child { padding-right: 0; }
  th, .selected { font-weight: 600; }
  .selected-run { background: rgb(var(--ink) / .05); }
</style>
