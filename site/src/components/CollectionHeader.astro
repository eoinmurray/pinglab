---
interface Props { name: string; id?: string; href?: string; heading?: 'h1' | 'h2'; }
const { name, id, href, heading: Heading = 'h1' } = Astro.props;
---

<div class="base-grid">
  <header class="collection-header l-page" id={id}>
    <Heading>{href ? <a href={href}>{name}</a> : name}</Heading>
  </header>
</div>

<style>
  .collection-header { margin-top: 2rem; padding-bottom: 1rem; border-bottom: 1px solid rgba(0, 0, 0, .15); scroll-margin-top: 24px; }
  h1, h2 { margin: 0; font-size: 32px; line-height: 1.2; }
  a { color: inherit; text-decoration: none; }
  a:hover { text-decoration: underline; }
</style>
