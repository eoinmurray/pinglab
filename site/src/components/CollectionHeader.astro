---
import CollectionMetadata from './CollectionMetadata.astro';

interface Props { name: string; id?: string; href?: string; heading?: 'h1' | 'h2'; description?: string; count?: number; latestDate?: string; }
const { name, id, href, description, count, latestDate, heading: Heading = 'h1' } = Astro.props;
---

<div class="base-grid">
  <header class="collection-header listing-width l-page" id={id}>
    <Heading>{href ? <a href={href}>{name}</a> : name}</Heading>
    {description && <p class="collection-description">{description}</p>}
    {count !== undefined && <CollectionMetadata count={count} latestDate={latestDate} />}
  </header>
</div>

<style>
  .collection-header { margin-top: 2rem; padding-bottom: 1rem; border-bottom: 1px solid rgb(var(--ink) / .15); scroll-margin-top: 24px; }
  h1, h2 { margin: 0; font-size: calc(32px * var(--listing-scale)); line-height: 1.2; }
  .collection-description { max-width: 70ch; margin: .75rem 0 0; font-size: calc(16px * var(--listing-scale)); line-height: 1.5; }
  a { color: inherit; text-decoration: none; }
  a:hover { text-decoration: underline; }
</style>
