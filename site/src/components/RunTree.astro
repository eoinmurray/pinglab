---
import type { RunTreeNode } from '../lib/run-lineage';
import { runWalltime, dataSize } from '../lib/run-metrics';
interface Props { node: RunTreeNode; path?: string[]; }
const { node } = Astro.props;
---
<ol class="tree">
  <li><code>{node.id}</code> — {node.row?.storage ?? 'Unavailable'} · {runWalltime(node.row?.record)} · {dataSize(node.row?.bytes)}
    {node.issue && <strong> · {node.issue}</strong>}
    {node.children.map(child => <Astro.self node={child} />)}
  </li>
</ol>
<style>
  .tree { margin: .35rem 0; padding-left: 1.25rem; font-size: .75rem; }
  code { font-size: inherit; }
  strong { color: #b42318; }
</style>
