---
import type { CollectionEntry } from 'astro:content';
import Page from './Page.astro';
import { dependencies, downstream } from '../lib/dependencies';
import Dataset from '../components/Dataset.astro';
import ArticleMetrics from '../components/ArticleMetrics.astro';
import ArticleDate from '../components/ArticleDate.astro';
import { countArticle } from '../lib/article-counts';
import { completedRunCount } from '../lib/pingstore';
import { collectionUrl, collectionLabel, collectionMemberships } from '../lib/collections';

const parameterTables = import.meta.glob('../../../experiments/exp*/report/parameters.mdx', { import: 'default' });
const appendices = import.meta.glob<import('astro').MDXInstance<Record<string, unknown>>>('../../../experiments/exp*/report/appendix.mdx');
const referenceLists = import.meta.glob('../../../experiments/exp*/report/references.mdx', { import: 'default' });
const networkDiagrams = import.meta.glob('../../../experiments/exp*/report/network.mdx', { import: 'default' });

interface Props {
  report: CollectionEntry<'reports'> | CollectionEntry<'notes'>;
  headings: { depth: number; slug: string; text: string }[];
}
const { report, headings } = Astro.props;
const { data } = report;
const collections = collectionMemberships(data.collection);
const experiment = report.collection === 'reports' ? report : undefined;
const mainContent = await Astro.slots.render('default');
const counts = { ...countArticle(mainContent, data.abstract), runs: experiment ? await completedRunCount(experiment.data.id) : undefined };
const articleDirectory = experiment ? `../../../experiments/${experiment.data.id}/report` : undefined;
const Parameters = await parameterTables[`${articleDirectory}/parameters.mdx`]?.() as import('astro').MarkdownInstance<Record<string, unknown>>['Content'] | undefined;
const References = await referenceLists[`${articleDirectory}/references.mdx`]?.() as import('astro').MarkdownInstance<Record<string, unknown>>['Content'] | undefined;
const appendix = await appendices[`${articleDirectory}/appendix.mdx`]?.();
const Appendix = appendix?.default;
const appendixHeadings = (await appendix?.getHeadings() ?? []).filter(heading => heading.depth === 2 || heading.depth === 3);
const appendixDepth = Math.min(3, ...appendixHeadings.map(heading => heading.depth));
const Network = await networkDiagrams[`${articleDirectory}/network.mdx`]?.() as import('astro').MarkdownInstance<Record<string, unknown>>['Content'] | undefined;
const hasDataset = experiment && (experiment.data.tags.includes('data') || (dependencies[experiment.data.id]?.length ?? 0) > 0 || downstream(experiment.data.id).length > 0);
const contents = [
  ...(data.abstract ? [{ slug: 'abstract', text: 'Abstract' }] : []),
  ...headings.filter(heading => heading.depth === 2 || heading.depth === 3),
  ...appendixHeadings.map(heading => ({ ...heading, depth: heading.depth - appendixDepth + 2 })),
  ...(Parameters ? [{ slug: 'parameters', text: 'Parameters' }] : []),
  ...(Network ? [{ slug: 'network', text: 'Network' }] : []),
  ...(hasDataset ? [{ slug: 'dataset', text: 'Dataset' }] : []),
  ...(References ? [{ slug: 'references', text: 'References' }] : []),
];
const frontMatter = {
  title: data.title,
  description: data.description,
  authors: [{ author: data.author, affiliations: [] }],
};
---

<Page title={data.title} description={data.description} frontMatter={frontMatter} distill>
  <d-title>
    <h1>{data.title}</h1>
    <p>{data.description}</p>
  </d-title>
  <d-byline>
    <div class="byline grid" style={`--byline-columns: ${experiment ? 5 : 4}`}>
      {experiment && <div><h3>Experiment</h3><p class="experiment-id">{experiment.data.id}</p></div>}
      <div><h3>Created</h3><p><ArticleDate date={data.created_at} /></p></div>
      <div><h3>Updated</h3><p><ArticleDate date={data.updated_at} /></p></div>
      <div>
        <h3>{collections.length === 1 ? 'Collection' : 'Collections'}</h3>
        <p>{collections.map((collection, index) => <>
          {index > 0 && <br />}
          <a class="collection-link" href={collectionUrl(collection)}>{collectionLabel(collection)}</a>
        </>)}</p>
      </div>
      <div class="report-statistics"><h3>Report</h3><ArticleMetrics counts={counts} stacked /></div>
    </div>
  </d-byline>
  <div class="report-body base-grid">
    <aside class="report-toc">
      <d-toc prerendered="true">
        <nav aria-label="Table of contents">
          <h2>Contents</h2>
          <ol>{contents.map(heading => <li class:list={{ subsection: 'depth' in heading && heading.depth === 3 }}><a href={`#${heading.slug}`}>{heading.text}</a></li>)}</ol>
        </nav>
      </d-toc>
    </aside>
    <d-article role="article" aria-label={data.title}>
      {data.abstract && <section class="report-abstract" aria-labelledby="abstract">
        <h2 id="abstract">Abstract</h2>
        <p>{data.abstract}</p>
      </section>}
      <Fragment set:html={mainContent} />
    </d-article>
  </div>
  {(Parameters || Appendix || References || Network || hasDataset) && <d-appendix distill-prerendered aria-label="Report appendix">
    {Appendix && <div class="report-appendix" data-heading-depth={appendixDepth}><Appendix /></div>}
    {Parameters && <>
      <h3 id="parameters">Parameters</h3>
      <section class="parameters" aria-labelledby="parameters"><Parameters /></section>
    </>}
    {Network && <>
      <h3 id="network">Network</h3>
      <section class="network" aria-labelledby="network"><Network /></section>
    </>}
    {hasDataset && experiment && <Dataset experiment={experiment.data.id} includeEvidence={experiment.data.tags.includes('data')} />}
    {References && <>
      <h3 id="references">References</h3>
      <section class="references" aria-labelledby="references"><References /></section>
    </>}
  </d-appendix>}
  <script is:inline type="application/json" class="js-hypothesis-config">
    {
      "showHighlights": true,
      "openSidebar": false
    }
  </script>
  <script is:inline async src="https://hypothes.is/embed.js"></script>
</Page>

<style is:global>
  d-byline { background: var(--surface); }
  d-appendix { background: var(--surface); color: rgb(var(--ink) / .65); }
  @media print { d-byline, d-appendix { background: white; } }
  d-byline .experiment-id { font-size: 18px; font-weight: 600; }
  d-byline .collection-link:hover { text-decoration: underline; }
  d-byline .byline > div { min-width: 0; }
  .report-appendix { display: contents; }
  .report-appendix > * { grid-column: text; min-width: 0; }
  .report-appendix > :is(h2, h3) { grid-column: text; }
  .report-appendix[data-heading-depth="2"] > h2,
  .report-appendix[data-heading-depth="3"] > h3 {
    grid-column: page-start / text-start;
    font-size: 15px;
    font-weight: 500;
    margin-top: 1em;
    margin-bottom: 0;
    color: rgb(var(--ink) / .65);
  }
  d-article > .source-table { grid-column: text; }
  :is(d-article, d-appendix) figcaption { margin-top: 1.25rem; }
  :is(d-article, d-appendix) figcaption > p:first-of-type { display: inline; margin: 0; }
  @media (min-width: 768px) { d-byline .byline { grid-template-columns: repeat(3, minmax(0, 1fr)); row-gap: 12px; } }
  @media (min-width: 1180px) { d-byline .byline { grid-template-columns: repeat(var(--byline-columns), minmax(0, 1fr)); } }
  .report-body { position: relative; --report-content-top: 4rem; }
  .report-body > d-article { grid-column: screen; grid-row: 1; min-width: 0; padding-top: var(--report-content-top); }
  .report-body > d-article > :first-child { margin-top: 0; }
  .report-toc { position: relative; z-index: 1; grid-column: screen-start / text-start; grid-row: 1; justify-self: end; box-sizing: border-box; width: min(304px, 100%); min-width: 0; padding: calc(var(--report-content-top) + 1px) 24px 0; }
  .report-toc d-toc { display: block; position: sticky; top: 24px; max-height: calc(100vh - 48px); overflow-y: auto; }
  .report-toc h2 { font-size: 13px; line-height: 1.5; font-weight: 600; margin: 0 0 12px; }
  .report-toc ol { list-style: none; margin: 0; padding: 0; }
  .report-toc li { margin-bottom: 10px; font-size: 12px; line-height: 1.5; }
  .report-toc .subsection { padding-left: 12px; }
  .report-toc a { color: rgb(var(--ink) / .6); text-decoration: none; border-bottom: none; }
  .report-toc a:hover { color: rgb(var(--ink)); }
  .report-abstract { grid-column: text; }
  .report-abstract h2 { margin-top: 0; }
  :is(d-article, d-appendix) [id] { scroll-margin-top: 24px; }
  @media (max-width: 1179px) {
    .report-toc { grid-column: text; grid-row: 1; justify-self: stretch; width: auto; padding: 32px 0 24px; }
    .report-toc d-toc { position: static; max-height: none; }
    .report-body > d-article { grid-row: 2; }
    .report-toc ol { columns: 2; column-gap: 24px; }
    .report-toc li { break-inside: avoid; }
  }
  @media print { .report-toc { display: none; } }
  d-appendix .parameters { min-width: 0; margin-bottom: 2rem; }
  d-appendix .parameters table { width: 100%; border-collapse: collapse; font-size: inherit; line-height: inherit; margin-top: 0; }
  d-appendix .parameters th, d-appendix .parameters td { text-align: left; padding: .6em .65em; border-bottom: 1px solid rgb(var(--ink) / .1); vertical-align: top; }
  d-appendix .parameters th:first-child, d-appendix .parameters td:first-child { padding-left: 0; width: 30%; }
  d-appendix .parameters th:last-child, d-appendix .parameters td:last-child { padding-right: 0; }
  @media (min-width: 1000px) {
    .report-appendix[data-heading-depth="2"] > h2,
    .report-appendix[data-heading-depth="2"] > h2 + *,
    .report-appendix[data-heading-depth="3"] > h3,
    .report-appendix[data-heading-depth="3"] > h3 + * { margin-top: 0; }
  }
  @media (max-width: 999px) {
    d-appendix h3,
    .report-appendix[data-heading-depth="2"] > h2,
    .report-appendix[data-heading-depth="3"] > h3 { grid-column: text; margin-bottom: 1em; }
  }
  .report-appendix[data-heading-depth="2"] > h2:not(:first-child),
  .report-appendix[data-heading-depth="3"] > h3:not(:first-child) {
    margin-top: var(--appendix-section-gap);
  }
  .report-appendix[data-heading-depth="2"] > h3 { margin-top: 2rem; }
  @media (min-width: 1000px) {
    .report-appendix[data-heading-depth="2"] > h2:not(:first-child) + *,
    .report-appendix[data-heading-depth="3"] > h3:not(:first-child) + * {
      margin-top: var(--appendix-section-gap);
    }
  }
</style>
