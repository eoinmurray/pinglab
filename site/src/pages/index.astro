---
import Page from '../layouts/Page.astro';
import ArticleBrowser from '../components/ArticleBrowser.astro';
import { getPosts } from '../lib/posts';
import { getPapers } from '../lib/papers';

const posts = await getPosts();
const papers = await getPapers();
---

<Page title="Articles" description="Scientific reports, notes, and slide decks from Pinglab." compact>
  <ArticleBrowser posts={posts} papers={papers} />
</Page>
