---
import Page from '../../layouts/Page.astro';
import PostsList from '../../components/PostsList.astro';
import CollectionHeader from '../../components/CollectionHeader.astro';
import { getPosts, type Post } from '../../lib/posts';
import { collectionLabel } from '../../lib/collections';

export async function getStaticPaths() {
  const posts = await getPosts();
  return [...new Set(posts.map(post => post.collection))]
    .map(collection => ({
      params: { collection },
      props: { collection, posts: posts.filter(post => post.collection === collection) },
    }));
}

interface Props { collection: string; posts: Post[]; }
const { collection, posts } = Astro.props;
const name = collectionLabel(collection);
---

<Page title={name} description={`Pinglab articles in ${name}.`}>
  <CollectionHeader name={name} />
  <PostsList posts={posts} />
</Page>
