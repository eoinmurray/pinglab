---
import { getCollection } from 'astro:content';
import { runStore } from '../lib/run-store';
import { runTree, reportRuns } from '../lib/run-lineage';
import Page from '../layouts/Page.astro';
import RunTree from '../components/RunTree.astro';
import { getReports } from '../lib/reports';
const index = await runStore.index();
const reports = await getReports();
const notes = await getCollection('notes');
const declared = [...new Set([...reports.flatMap(report => [report.id, ...report.data.inputs]),
  ...notes.flatMap(note => [...note.data.inputs, ...(note.data.presentation ? [note.data.presentation] : [])])])];
const used = reportRuns(index, declared);
const experiments = [...new Set(Object.values(index.runs).map(row => row.record.experiment))].sort().reverse();
---
<Page title="Pingstore" description="Stored runs and their dependencies." noindex>
  <d-title><h1>Pingstore</h1></d-title>
  <d-article role="article" aria-label="Pingstore">
    <p>{Object.keys(index.runs).length} stored runs. {Object.keys(index.runs).filter(id => used.has(id)).length} are referenced by this site's current report selections.</p>
    <p>Storage labels describe this inventory snapshot. Runs remain stored until explicitly deleted.</p>
    {experiments.map(experiment => {
      const selected = declared.includes(experiment) ? index.selections[experiment] : undefined;
      const own = Object.values(index.runs).filter(row => row.record.experiment === experiment);
      const report = reports.find(report => report.id === experiment);
      return <section>
        <h2>{report ? <a href={`/${experiment}`}>{experiment} — {report.data.title}</a> : experiment}</h2>
        {selected && <><h3>Selected presentation and dependencies</h3><RunTree node={runTree(index, selected)} /></>}
        <details><summary>All stored runs ({own.length})</summary>
          {own.sort((a, b) => Date.parse(b.record.created_at) - Date.parse(a.record.created_at)).map(row => <RunTree node={runTree(index, row.record.id)} />)}
        </details>
      </section>;
    })}
  </d-article>
</Page>
<style>
  section { min-width: 0; margin: 1.5rem 0; }
  h2 { font-size: 1rem; }
  h3, p, summary { font-size: .8rem; }
  details { overflow-x: auto; }
</style>
