---
import Page from '../layouts/Page.astro';
import { getPosts } from '../lib/posts';
import { collectionLabel, collectionUrl, compareCollections } from '../lib/collections';

const posts = await getPosts();
const names = [...new Set(posts.map(post => post.collection))].sort(compareCollections);
---

<Page title="Collections" description="Browse Pinglab articles by collection.">
  <div class="base-grid">
    <ol class="collections-list l-page" aria-label="Collections">
      {names.map(name => <li><a href={collectionUrl(name)}>{collectionLabel(name)}</a></li>)}
    </ol>
  </div>
</Page>

<style>
  .collections-list { list-style: none; padding: 0; margin: 24px 0; }
  .collections-list li { margin: 0; border-bottom: 1px solid rgba(0, 0, 0, .1); }
  .collections-list li:last-child { border-bottom: none; }
  .collections-list a { display: block; padding: 24px 0; color: inherit; font-size: 24px; font-weight: 700; line-height: 1.2; text-decoration: none; }
  .collections-list a:hover { text-decoration: underline; }
  .collections-list a:focus-visible { outline: 2px solid #004276; outline-offset: 6px; }
  @media (min-width: 768px) {
    .collections-list { margin-top: 60px; }
    .collections-list a { font-size: 26px; }
  }
</style>
