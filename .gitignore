# Cached datasets (MNIST, etc.) pulled into a run's data dir
**/data/MNIST/

node_modules
.coverage

# demolab (Typst publishing) + experiment scratch + build output
temp/
tmp/
.scratch/
runs/
.pingstore/
.r2/
# CLI scratch if the default artifact root is ever hit (normally writes to temp/)
tools/artifacts/

# atomic-publish staging dirs (run_dirs.published_run): a run writes here and the
# dir is renamed into the published data dir on success — transient, never committed.
.artifacts/*.staging/

# demolab engine staging (materialised by the demolab CLI; regenerated on engine updates)
.demolab/

# Canvas source and small manifests are tracked selectively, but simulations and
# intermediate renders are local replay caches. Final media belongs in
# canvas-output/.
.canvas/**/snapshot.npz
.canvas/**/recurrent-weights.npz
.canvas/**/*.mp4
.canvas/**/*.png
.canvas/**/__pycache__/
.canvas/**/snnlang-sweep/
.canvas/**/sweep-ee/
.canvas/**/sweep-ping/
.canvas/**/drive-sweep/

# Exported video is retained locally or archived externally. The repository's
# compact-artifact CI rejects newly tracked files larger than 5 MiB.
canvas-output/**/*.mp4
