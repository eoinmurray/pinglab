---
import Table from '../../../site/src/components/Table.astro';
import { formatTableNumber as n } from '../../../site/src/lib/table-number';
interface Props { data?: any; number?: number | string; caption?: string; }
const { data, number, caption } = Astro.props;
const conditions = ['AI','PING'];
const cfg = condition => data?.[condition];
const value = (label, read) => [label, ...conditions.map(condition => cfg(condition) ? read(condition) : 'Unavailable')];
const rows = [
  value('External rate', condition => `${n(cfg(condition).external_rate_hz)} Hz/source`),
  value('External connection probability', condition => `${n(100 * cfg(condition).input_connection_probability)}%`),
  value('External→I gain', condition => n(cfg(condition).input_i_gain)),
];
---
<Table headers={['Parameter','AI-like','PING']} rows={rows} number={number} id={`parameter-differences-${number}`} label={caption ?? 'Parameter differences between AI and PING'}>
  These are the only independent recorded settings that differ between the two
  conditions. All other settings, including timestep, integration duration,
  seed, populations, recurrent weights and neuron dynamics, are shared.
  {number === 3 ? ' The values match Table 1 because the same three external-drive parameters distinguish AI and PING in both recurrence implementations.' : ''}
</Table>
