---
import RunFigure from '../../../site/src/components/RunFigure.astro';
import { reportData } from '../../../site/src/lib/report-data';
const data = await reportData('exp171', { allowUnavailable: true });
const testSet = Boolean(data?.test_frontier);
---
{data?.sweep ? <RunFigure report="exp171" experiment="exp171" file="activity-frontier.svg"
  number={1} id="fig-frontier" alt={`Final ${testSet ? 'test' : 'validation'} accuracy versus achieved E firing rate across matched activity ceilings.`}>
  Final {testSet ? 'test' : 'validation'} accuracy versus mean E firing rate (Hz/neuron).
  Red squares: TR02 COBA; black diamonds: TR02 PING; cyan triangles: artificial I.
  Labels give training ceilings (Hz); stars mark unpenalised conditions.
  Lines follow firing-rate order. Controls use epoch 50; students train for ten more epochs.
  {testSet ? <>All curves use the same 1,000 official MNIST test images and manuscript
  sensory encoding. COBA/PING scores come from TR02; only student endpoints are
  newly evaluated. Seed 42; no across-seed error bars.</> : <>The source validation
  split is reused. One seed; no replicate error bars.</>}
</RunFigure> : <p>No completed sweep is selected.</p>}
