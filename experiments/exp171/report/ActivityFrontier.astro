---
import RunFigure from '../../../site/src/components/RunFigure.astro';
import { reportData } from '../../../site/src/lib/report-data';
const data = await reportData('exp171', { allowUnavailable: true });
---
{data?.sweep ? <RunFigure report="exp171" experiment="exp171" file="activity-frontier.svg"
  number={3} id="fig-frontier" alt="Final validation accuracy versus achieved E firing rate across matched activity ceilings.">
  Final validation accuracy versus E firing. Black: TR02 COBA; red: TR02 PING;
  cyan: artificial-I fine-tuning. Labels give activity ceilings; Off disables
  the penalty. Lines connect conditions. One seed; students receive extra training.
</RunFigure> : <p>No completed sweep is selected.</p>}
