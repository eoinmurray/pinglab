---
import { reportData, reportSnapshots, round } from '../../../site/src/lib/report-data';
const data = await reportData('exp171', { allowUnavailable: true });
const evidence = await reportSnapshots('exp171', { snapshots: {
  coba: data?.execution_backend === 'snnlab.sim.train' ? 'training/start/snapshot.json' : 'initial/start/snapshot.json',
}, computeInput: 'compute', allowUnavailable: true });
const method = evidence?.configuration?.inhibition_method;
---
{data?.sweep ? <p>We fine-tune COBA for {evidence.configuration.epochs} epochs with PING-calibrated private inhibition across {data.sweep.length} matched TR02 activity ceilings. We measure {data.test_frontier ? 'test accuracy and E firing on 1,000 official MNIST test images' : 'validation accuracy and E firing'} for one seed.</p> : data ? <p>We fine-tune COBA with PING-calibrated private inhibition. Validation accuracy changed from {round(data.history[0].accuracy_pct, 1)}% to {round(data.history.at(-1).accuracy_pct, 1)}%. One seed; the source validation split is reused.</p> : <p>No completed evidence is selected.</p>}

{data && method !== 'poisson_moment_matched_v1' ? <p>Selected results predate the Poisson control. The current method matches stationary PING conductance moments; all six conditions need fresh runs.</p> : null}
