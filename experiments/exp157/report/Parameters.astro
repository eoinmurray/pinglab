---
import Table from '../../../site/src/components/Table.astro';
import { reportData, reportSnapshots } from '../../../site/src/lib/report-data';
import { runStore } from '../../../site/src/lib/run-store';

const evidence = await reportSnapshots('exp157', { snapshots: {}, allowUnavailable: true });
const cfg = evidence?.configuration;
const frequency = (await reportData('exp157', { allowUnavailable: true }))?.configuration?.figure_frequency_estimator;
const model = evidence ? await runStore.json(evidence.compute.run_id, 'export/model.json') : undefined;
const groups = (() => {
  if (!cfg || !model) return [{ label: 'Evidence', rows: [['Parameters', 'Unavailable']] }];
  if (model.schema !== 'snnlab.meanfield.model/v1') throw new Error('Invalid native mean-field model');
  const parameter = name => {
    const value = model.parameters[name]?.value;
    if (typeof value !== 'number' || !Number.isFinite(value)) throw new Error(`Missing native mean-field parameter ${name}`);
    return value;
  };
  const e = model.model_definition.functions.Phi_A_E;
  const i = model.model_definition.functions.Phi_A_I;
  return [
    { label: 'Network and native mean-field gain', rows: [
      ['Architecture', 'A_E → C_E; B_E → C_E; no A↔B or C feedback'],
      ['External projections', Object.keys(model.parameters).filter(name => name.startsWith('X_') && name.endsWith('.coupling')).map(name => name.replace('.coupling','')).join('; ')],
      ['E / I neurons per reference circuit', `${model.parameters['A_E_to_A_I.coupling'].aggregation.source_count} / ${model.parameters['A_E_to_A_I.coupling'].aggregation.target_count}`],
      ['Dynamical states', model.state_order.length],
      ['E / I membrane time constant (ms)', `${e.tau_mem_ms.toFixed(5)} / ${i.tau_mem_ms.toFixed(5)}`],
      ['Leak conductance (µS)', e.leak_us],
      ['Rest / reset / threshold (mV)', `${e.resting_mv} / ${e.reset_mv} / ${e.threshold_mv}`],
      ['E / I refractory time (ms)', `${e.refractory_ms} / ${i.refractory_ms}`],
      ...['A','B','C'].map(c => [`${c} E / I rate relaxation (ms)`, `${parameter(c+'_E.tau_rate').toPrecision(8)} / ${parameter(c+'_I.tau_rate').toPrecision(8)}`]),
      ['Noise scale / quadrature nodes (mV / count)', `${e.sigma_mv} / ${e.quadrature_nodes}`],
    ] },
    { label: 'Native incoming conductance sums', rows: Object.entries(model.parameters).filter(([name]) => name.endsWith('.coupling')).map(([name, row]) => [name.replace('.coupling', '') + ' incoming sum (µS)', row.value]) },
    { label: 'Native synaptic filters', rows: Object.entries(model.parameters).filter(([name]) => name.endsWith('.tau')).map(([name, row]) => [name.replace('.tau', '') + ' decay (ms)', row.value]) },
    { label: 'Drive protocol and numerical calculation', rows: [
      ['Window count / duration (ms)', `${cfg.duration_ms/cfg.window_ms} / ${cfg.window_ms}`],
      ['Total duration / sampling interval (ms)', `${cfg.duration_ms} / ${cfg.sample_interval_ms}`],
      ['C held input (Hz/source)', cfg.c_drive_hz],
      ['A held input (Hz/source)', cfg.a_drive_hz],
      ['B held / final input (Hz/source)', `${cfg.b_hold_drive_hz} / ${cfg.b_final_drive_hz.toPrecision(9)}`],
      ['Initial rates / conductances', 'All zero; no warm-up or reset'],
      ['External filters / delays', 'Dynamic / zero-delay ODE'],
      ['Solver / maximum step (ms)', `${cfg.solver.method} / ${cfg.solver.max_step_ms}`],
      ['Relative / absolute tolerance', `${cfg.solver.rtol} / ${cfg.solver.atol}`],
      ['Original B:A E-rate target / averaging duration (ms)', `${cfg.target.b_to_a_e_rate} / ${cfg.target.terminal_average_ms}`],
      ['Target relative error tolerance', cfg.target.relative_tolerance],
      ['Calibration policy', cfg.calibration_policy ?? 'Original finite-window calibration'],
      ['Autonomous frequency targets A / C / B (Hz)', cfg.frequency_calibration ? `${cfg.frequency_calibration.targets_hz.A} / ${cfg.frequency_calibration.targets_hz.C} / ${cfg.frequency_calibration.targets_hz.B}` : 'Unavailable'],
      ['Autonomous calibration measurement (ms)', cfg.frequency_calibration ? `${cfg.frequency_calibration.measure_start_ms}–${cfg.frequency_calibration.duration_ms}` : 'Unavailable'],
      ['Autonomous target tolerance (Hz)', cfg.frequency_calibration?.tolerance_hz ?? 'Unavailable'],
      ['Self recurrence multiplier', cfg.self_recurrence_scale ?? 1],
    ] },
    { label: 'Figure 1 rhythm and phase estimator', rows: [
      ['Hold transient discarded (ms)', cfg.analysis.hold_discard_ms],
      ['Gamma band (Hz)', cfg.analysis.gamma_band_hz.join('–')],
      ['Absolute / relative amplitude floor (Hz / fraction)', `${cfg.analysis.min_amplitude_hz} / ${cfg.analysis.min_relative_amplitude}`],
      ['Minimum late / early amplitude ratio', cfg.analysis.min_late_early_ratio],
      ['400 ms analysis minimum peaks / maximum interval CV', `${cfg.analysis.min_peaks} / ${cfg.analysis.max_interval_cv}`],
      ['Figure frequency estimator', frequency?.method ?? 'Unavailable'],
      ['Frequency placement / connection', frequency ? 'Interval midpoint / straight lines; no extrapolation' : 'Unavailable'],
      ['Frequency amplitude / prominence window (ms)', frequency?.detection_window_ms ?? 'Unavailable'],
      ['Frequency peak prominence (Hz / local range fraction)', frequency ? `${frequency.minimum_prominence_hz} / ${frequency.relative_prominence}` : 'Unavailable'],
      ['Frequency rhythm gate', frequency ? String(frequency.rhythm_gate) : 'Unavailable'],
      ['Minimum peak separation (ms)', Math.floor(1000/cfg.analysis.gamma_band_hz[1]/cfg.sample_interval_ms*0.8)*cfg.sample_interval_ms],
      ['Phase gate window / spacing (ms)', `${cfg.analysis.frequency_window_ms} / ${cfg.analysis.frequency_step_ms}`],
      ['Phase gate minimum peaks', Math.max(3,Math.min(cfg.analysis.min_peaks,Math.floor(cfg.analysis.frequency_window_ms*cfg.analysis.gamma_band_hz[0]/1000)-1))],
      ['Phase interpolation', 'Linear between observed peaks; no extrapolation'],
    ] },
  ];
})();

---
<Table headers={['Parameter', 'Value']} groups={groups} id="parameters" />
