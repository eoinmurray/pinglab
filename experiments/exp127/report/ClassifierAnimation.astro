---
import { imageUrl, latestPresentation } from '../../../site/src/lib/pingstore';
interface Props { experiment: string; }
const { experiment } = Astro.props;
const run = (await latestPresentation(experiment)).id;
---
<figure class="l-body" id="fig-inference">
  <pixi-learning-classifier data-source={await imageUrl(run, 'classifier.json')}>
    <div class="selectors">
      <div class="mode" role="group" aria-label="Training snapshot"><button type="button" data-mode="before" aria-pressed="true" disabled>Before Training</button><button type="button" data-mode="after" aria-pressed="false" disabled>After Training</button></div>
      <div class="options" role="group" aria-label="Input class"><button type="button" data-example="0" aria-pressed="true" disabled>Class A</button><button type="button" data-example="1" aria-pressed="false" disabled>Class B</button></div>
    </div>
    <div class="scene" role="img" aria-label="Recorded SNNLab classifier: three Poisson input channels feed two output neurons through six synapses. Each output neuron contains a gauge showing its recorded membrane voltage, from rest to firing threshold. Toggle before or after training to replay identical inputs with the corresponding measured voltages, output spikes, weights, and predictions.">
      <p class="status" role="status">Loading classifier…</p>
    </div>
    <div class="controls">
      <button type="button" data-replay disabled>Replay</button>
      <button type="button" data-pause disabled>Pause</button>
    </div>
    <noscript>The before/after replay requires JavaScript. It compares recorded responses to identical input spike sequences.</noscript>
  </pixi-learning-classifier>
  <figcaption>Figure 4: Recorded SNNLab responses to the same inputs before and after training. Thicker lines mean stronger connections; gauges show voltage and bars count spikes. Pink marks the firing threshold. Rest and reset are −65 mV (<i>E</i><sub>L</sub> = <i>V</i><sub>reset</sub>); the threshold is −50 mV. Spike motion is illustrative.</figcaption>
</figure>

<script>
  import { mountClassifier } from './js/classifier.js';
  class PixiLearningClassifier extends HTMLElement {
    dispose?: () => void;
    observer?: IntersectionObserver;
    connectedCallback() {
      this.observer = new IntersectionObserver(async entries => {
        if (!entries.some(entry => entry.isIntersecting)) return;
        this.observer?.disconnect();
        try {
          const dispose = await mountClassifier(this);
          if (this.isConnected) this.dispose = dispose; else dispose();
        } catch (error) {
          console.error('Classifier replay could not start', error);
          const status = this.querySelector('.status');
          if (status) status.textContent = 'The recorded classifier replay is unavailable.';
        }
      }, { rootMargin: '200px' });
      this.observer.observe(this);
    }
    disconnectedCallback() { this.observer?.disconnect(); this.dispose?.(); }
  }
  if (!customElements.get('pixi-learning-classifier')) customElements.define('pixi-learning-classifier', PixiLearningClassifier);
</script>

<style>
  pixi-learning-classifier { display: block; box-sizing: border-box; padding: 12px; border: 1px solid #d6dfe7; border-radius: 12px; background: white; }
  .scene { width: 100%; aspect-ratio: 124 / 40; position: relative; }
  .scene :global(canvas) { display: block; width: 100%; height: 100%; }
  .scene :global(.classifier-labels) { position: absolute; inset: 0; pointer-events: none; font-family: system-ui, sans-serif; }
  .status { position: absolute; inset: 0; display: grid; place-content: center; padding: 24px; margin: 0; text-align: center; }
  .controls { display: flex; width: 100%; box-sizing: border-box; align-items: center; flex-wrap: wrap; gap: 12px; padding: 12px 4px 4px; border-top: 1px solid #eaf0f4; }
  .selectors { display: flex; align-items: center; flex-wrap: wrap; gap: 12px 24px; padding: 4px 4px 12px; margin-bottom: 8px; border-bottom: 1px solid #eaf0f4; }
  .mode, .options { display: flex; gap: 4px; }
  button { border: 1px solid #cbd5df; border-radius: 6px; padding: 6px 14px; background: #f5f7f9; color: #263343; font: 13px/1.4 system-ui, sans-serif; cursor: pointer; }
  button { min-width: 70px; }
  button[aria-pressed="true"] { background: #e6eef4; border-color: #8da9be; }
  button:hover { background: #eaf0f4; }
  button:focus-visible { outline: 2px solid #176d91; outline-offset: 3px; }
  button:disabled { opacity: 0.5; cursor: default; }
  figcaption { margin-top: 12px; }
  @media (max-width: 600px) { .scene { aspect-ratio: 64 / 44; } }
  @media (min-width: 1180px) { figure { grid-column: text-start / page-end; display: grid; grid-template-columns: subgrid; } pixi-learning-classifier { grid-column: 1 / -1; } figcaption { grid-column: text; } }
</style>
