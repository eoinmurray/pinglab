---
interface Props { dual?: boolean; }
const { dual = false } = Astro.props;
---
<figure class="l-body" id={dual ? "fig-ei-synapses" : "fig-synapse"}>
  <pixi-conductance-synapse data-dual={dual ? "true" : undefined}>
    <div class="scene" role="img" aria-label={dual ? "A: E and I presynaptic neurons send spikes to separate excitatory and inhibitory conductance channels in the receiving neuron membrane. B: g_E and g_I against time. C: receiving neuron voltage V_m with firing threshold and reset. Blue denotes excitation, rose inhibition; rose output pulses mark receiving-neuron spikes." : "A: spikes travel directly to one schematic conductance channel embedded in the neuron membrane. B: synaptic conductance g_syn over time t. C: membrane voltage V_m over the same time window; sliders control w_event, tau_syn and E_syn."}>
      <p class="status" role="status">Loading synapse…</p>
    </div>
    <div class:list={["controls", { "dual-controls": dual } ]}>
      {dual ? <>
      <label><span>Weight <i>w</i><sub>E</sub></span> <input data-weight type="range" min="0" max="8" step="0.5" value="8" /><output data-weight-value>8 nS</output></label>
      <label><span>Weight <i>w</i><sub>I</sub></span> <input data-weight-i type="range" min="0" max="8" step="0.5" value="4" /><output data-weight-i-value>4 nS</output></label>
      <label><span>Reversal <i>E</i><sub>E</sub></span> <input data-reversal type="range" min="-80" max="0" step="1" value="0" /><output data-reversal-value>0 mV</output></label>
      <label><span>Reversal <i>E</i><sub>I</sub></span> <input data-reversal-i type="range" min="-90" max="0" step="1" value="-75" /><output data-reversal-i-value>−75 mV</output></label>
      </> : <>
      <label><span>Weight <i>w</i><sub>event</sub></span> <input data-weight type="range" min="1" max="8" step="0.5" value="8" /><output data-weight-value>8 nS</output></label>
      <label><span>Decay <i>τ</i><sub>syn</sub></span> <input data-tau type="range" min="3" max="30" step="1" value="12" /><output data-tau-value>12 ms</output></label>
      <label><span>Reversal <i>E</i><sub>syn</sub></span> <input data-reversal type="range" min="-80" max="0" step="1" value="0" /><output data-reversal-value>0 mV</output></label>
      </>}
      <button type="button" data-pause disabled>Pause</button>
    </div>
    <noscript>Spikes increase conductance. Current through the synapse pulls the receiving neuron's voltage towards the reversal potential.</noscript>
  </pixi-conductance-synapse>
  {dual ? <figcaption><strong>Figure 2.</strong> Excitatory (blue) and inhibitory (rose) spikes feed one neuron. A shows the inputs and channels, B their conductances, and C the neuron's voltage. Rose pulses show output spikes. Dashed lines mark reversal potentials; arrows indicate values outside the graph.</figcaption> :
  <figcaption><strong>Figure 1.</strong> Spikes open the channel in A. B shows its conductance; C shows the neuron's voltage. A wider opening means greater conductance. At threshold, the neuron fires and resets. The blue dashed line marks reversal potential; an arrow indicates a value outside the graph.</figcaption>}

</figure>

<script>
  import { mountSynapse } from '../js/synapse.js';
  class ConductanceSynapse extends HTMLElement {
    dispose?: () => void;
    observer?: IntersectionObserver;
    connectedCallback() {
      this.observer = new IntersectionObserver(async entries => {
        if (!entries.some(entry => entry.isIntersecting)) return;
        this.observer?.disconnect();
        try {
          const dispose = await mountSynapse(this);
          if (this.isConnected) this.dispose = dispose;
          else dispose();
        } catch (error) {
          console.error('Synapse animation could not start', error);
          const status = this.querySelector('.status');
          if (status) status.textContent = 'The animation could not start. Equations and the figure caption describe the model.';
        }
      }, { rootMargin: '200px' });
      this.observer.observe(this);
    }
    disconnectedCallback() { this.observer?.disconnect(); this.dispose?.(); }
  }
  if (!customElements.get('pixi-conductance-synapse')) customElements.define('pixi-conductance-synapse', ConductanceSynapse);
</script>

<style>
  pixi-conductance-synapse { display: block; box-sizing: border-box; padding: 12px; border: 1px solid #d6dfe7; border-radius: 12px; background: white; }
  .scene { width: 100%; aspect-ratio: 124 / 36; position: relative; }
  .scene :global(canvas) { display: block; width: 100%; height: 100%; }
  .scene :global(.synapse-math-labels) { position: absolute; inset: 0; pointer-events: none; font-family: system-ui, sans-serif; color: #263343; }
  .scene :global(.synapse-math-labels sub) { font-size: .75em; line-height: 0; vertical-align: baseline; position: relative; bottom: -.2em; }
  .controls label > span { white-space: nowrap; }
  .status { position: absolute; inset: 0; display: grid; place-content: center; padding: 24px; margin: 0; text-align: center; }
  .controls { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)) auto; align-items: center; gap: 16px; width: 100%; box-sizing: border-box; padding: 12px 4px 4px; border-top: 1px solid #eaf0f4; }
  .dual-controls { grid-template-columns: repeat(4, minmax(0, 1fr)) auto; gap: 16px; }
  .dual-controls label { grid-template-columns: auto minmax(0, 1fr) 32px; gap: 6px; }
  .dual-controls output { width: 32px; min-width: 32px; }
  .controls label { display: grid; grid-template-columns: auto minmax(0, 1fr) 48px; align-items: center; min-width: 0; gap: 8px; font: 13px/1.4 system-ui, sans-serif; color: #263343; }
  input[type="range"] { width: 100%; min-width: 0; margin: 0; accent-color: #626b74; }
  output { display: inline-block; width: 48px; min-width: 48px; text-align: right; white-space: nowrap; font-variant-numeric: tabular-nums; }
  input:focus-visible { outline: 2px solid #176d91; outline-offset: 3px; }
  button { border: 1px solid #cbd5df; border-radius: 6px; padding: 6px 14px; background: #f5f7f9; color: #263343; font: 13px/1.4 system-ui, sans-serif; cursor: pointer; min-width: 80px; }
  button:hover { background: #eaf0f4; }
  button:focus-visible { outline: 2px solid #176d91; outline-offset: 3px; }
  button:disabled { opacity: 0.5; cursor: default; }
  figcaption { margin-top: 12px; }
  @media (min-width: 1180px) {
    figure { grid-column: text-start / page-end; display: grid; grid-template-columns: subgrid; }
    pixi-conductance-synapse { grid-column: 1 / -1; }
    figcaption { grid-column: text; }
  }
  @media (max-width: 1100px) { .dual-controls label { grid-template-columns: minmax(0, 1fr); gap: 6px; } .dual-controls label > span { white-space: normal; } }
  @media (max-width: 900px) {
    .controls { gap: 10px; }
  .controls label { grid-template-columns: minmax(0, 1fr); gap: 6px; }
    .controls label > span { white-space: normal; }
    .controls output { text-align: left; }
  }
  @media (max-width: 600px) {
    .scene { aspect-ratio: 62 / 36; }
    .controls { gap: 8px; }
  .controls label { font-size: 11px; }
    .controls button { min-width: 50px; padding: 6px 8px; font-size: 12px; }
  }
</style>
