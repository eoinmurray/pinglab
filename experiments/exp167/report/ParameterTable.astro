---
import Table from '../../../site/src/components/Table.astro';
import { reportData } from '../../../site/src/lib/report-data';
import { formatTableNumber as n } from '../../../site/src/lib/table-number';
const saved = await reportData('exp167', { allowUnavailable: true });
const cfg = saved?.configuration;
const math = value => ({math:value});
const shared = (label,value) => [label,value,value];
const pair = (a,b,unit) => `${n(a)} / ${n(b)} ${unit}`;
const groups = cfg ? [
  {label:'Simulation',rows:[
    shared(math('\\text{Timestep }dt'), `${n(cfg.dt_ms)} ms`),
    shared('Full duration',`${n(cfg.duration_ms)} ms`),
    shared('Excluded initial interval',`${n(cfg.burn_in_ms)} ms`),
    shared('Network seed',String(cfg.seed)),
    shared('Input seed',String(cfg.seed+cfg.external_seed_offset)),
  ]},
  {label:'Populations',rows:[
    shared(math('E'),`${n(cfg.n_e)} conductance-LIF neurons`),
    shared(math('I'),`${n(cfg.n_i)} conductance-LIF neurons`),
    shared(math('X'),`${n(cfg.n_external)} external spike sources`),
  ]},
  {label:'Neuron dynamics',rows:[
    shared('Membrane time constant, E / I',pair(cfg.capacitance_nf/cfg.leak_us,cfg.capacitance_nf/cfg.leak_us,'ms')),
    shared('Refractory period, E / I',pair(cfg.refractory_e_ms,cfg.refractory_i_ms,'ms')),
  ]},
  {label:'Input and manipulation',rows:[
    shared('External rate',`${n(cfg.external_rate_hz)} Hz/source`),
    ['Input→I baseline / final gain',pair(cfg.control.baseline_gain,cfg.conditions.AI,''),pair(cfg.control.baseline_gain,cfg.conditions.PING,'')],
    shared('Input→I transition start / end',pair(cfg.control.ramp_start_ms,cfg.control.ramp_end_ms,'ms')),
    shared('Input→I transition duration',`${n(cfg.control.ramp_end_ms-cfg.control.ramp_start_ms)} ms`),
    shared('Synaptic decay',`${n(cfg.tau_synapse_ms)} ms`),
    shared('Excitatory / inhibitory delay',pair(cfg.excitatory_delay_ms,cfg.inhibitory_delay_ms,'ms')),
  ]},
  {label:'Measurement',rows:[
    shared('Half-open measurement window',`${n(cfg.measurement_ms[0])}–${n(cfg.measurement_ms[1])} ms`),
    shared('Population-count bin',`${n(cfg.analysis.population_bin_ms)} ms`),
    shared('Minimum spikes per cell for ISI CV',n(cfg.analysis.cv_min_spikes)),
    shared('Correlation sample, E / I',`${n(cfg.analysis.correlation_cells_per_population)} / ${n(cfg.analysis.correlation_cells_per_population)} cells`),
    shared('Correlation count bin',`${n(cfg.analysis.correlation_bin_ms)} ms`),
  ]},
] : [{label:'Evidence',rows:[['Recorded source configuration','Unavailable','Unavailable']]}];
const matrices = cfg ? ['AI','PING'].map(label=>({label, rows:['E','I','X'].map(source=>[
  math(source),...['E','I'].map(target=>{
    const path=`${source}_to_${target}`;
    const density=source==='X'?cfg.input_connection_probability:cfg.connection_probability;
    const gain=path==='X_to_I'?cfg.conditions[label]:1;
    const mean=1000*cfg.initializer_parent_means_us[path]/density*gain;
    if (!Number.isFinite(mean)) throw new Error('Missing recorded connection setting: '+path);
    return `${n(100*density)}%; ${n(mean)} ± ${n(mean*cfg.weight_relative_sd)} nS`;
  }),
])})) : [];
---
<Table headers={['Parameter','AI','PING']} groups={groups} number="A1" label="Source-configured comparison parameters">
  Values come from the selected runset's archived-source reconstruction, not
  current recipe defaults. E and I denote excitatory and inhibitory neurons;
  X is the shared external input pool. E / I pairs follow that order. Seeds
  are exact identifiers. Historical execution snapshots are missing, so these
  are nominal source settings rather than independently verified executed
  parameters. The short transition duration is shown separately because its
  start and end round to the same value at two significant figures.
</Table>
{matrices.map((matrix,index)=><Table headers={['Source ↓ / target →',math('E'),math('I')]}
  rows={matrix.rows} rowHeaders number={`A${index+2}`} label={`${matrix.label} nominal connectivity after the Input→I transition`}>
  {matrix.label} condition after the Input→I transition. Cells give eligible-pair
  connection density and nominal connected Gaussian parent mean ± SD of the
  conductance jump, before lower clamping. Values account for the source's
  sparsification compensation, input scaling and final scheduled gain; they
  are not measured matrix statistics. Self-connections are excluded on E→E
  and I→I. A zero Input→I gain retains the projection and its mask; existing
  conductance decays rather than being reset. All other gains remain one.
</Table>)}
