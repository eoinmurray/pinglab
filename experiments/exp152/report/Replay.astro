---
import { getEntry } from 'astro:content';
import { latestPresentation, imageUrl } from '../../../site/src/lib/pingstore';
interface Props { run: string }
const { run } = Astro.props;
const pin = (await getEntry('reports', run))?.data.runs?.[run];
const identity = pin ?? (await latestPresentation(run)).id;
---
<figure class="l-body" id="joint-replay">
  <joint-replay class="joint-recording" data-source={await imageUrl(identity, 'circuit.json')}>
    <div data-id="error" role="alert" hidden></div>
    <section class="panel" aria-label="Recorded circuit and callback replay">
      <div class="replay-visuals">
        <div class="circuit-area">
          <div class="canvas-scroll"><div data-id="circuit" class="surface circuit" role="img" aria-label="Flexor and extensor controllers with vertically stacked motor and inhibitory populations, two directional peer-inhibition paths and motor outputs driving the central rotary joint"></div></div>
        </div>
        <div class="dynamics-area">
          <div class="timing-title">Dynamics</div>
          <div class="canvas-scroll"><div data-id="dynamics" class="surface dynamics" role="img" aria-label="Recorded dynamics over the full run: joint angle in degrees, then flexor motor, flexor inhibitory, extensor motor and extensor inhibitory neuron voltages in millivolts; click to seek"></div></div>
        </div>
        <div class="timings-area">
          <div class="timing-title">Callback Timings</div>
          <div class="canvas-scroll"><div data-id="overview" class="surface timing" role="img" aria-label="Callback duration traces for all three nodes over the full run with a dashed callback-period reference; click to seek"></div></div>
        </div>
      </div>
      <div class="transport">
        <button data-id="play" class="primary" disabled>Pause</button>
        <button data-id="restart" disabled>Restart</button>
        <label class="scrub-label"><span class="sr-only">Replay time in milliseconds</span><input data-id="scrub" type="range" min="0" max="8000" step="0.1" value="0" disabled /></label>
        <label>Speed <select data-id="speed" disabled><option value="0.025">0.025×</option><option value="0.1">0.1×</option><option value="0.25" selected>0.25×</option><option value="0.5">0.5×</option><option value="1">1×</option><option value="2">2×</option></select></label>
      </div>
    </section>
  </joint-replay>

</figure>
<script>
  import { mountReplay } from './js/replay.js';
  class JointReplay extends HTMLElement {
    dispose?: () => void;
    async connectedCallback() {
      const dispose = await mountReplay(this);
      if (this.isConnected) this.dispose = dispose;
      else dispose();
    }
    disconnectedCallback() { this.dispose?.(); }
  }
  if (!customElements.get('joint-replay')) customElements.define('joint-replay', JointReplay);
</script>
<style>
  figure > joint-replay { display: block; }
  @media (min-width: 1180px) {
    figure { grid-column: text-start / page-end; display: grid; grid-template-columns: subgrid; }
    joint-replay { grid-column: 1 / -1; }
  }
</style>
<style is:global>
.joint-recording {
  display: block; container-type: inline-size; font-family: Inter, system-ui, sans-serif; color: #263343;
  --blue: #176d91; --muted: #687787; --line: #dce3e8; --red: #bc3b43;
  * { box-sizing: border-box; }
  .panel { width: 100%; max-width: max(280px, calc((100svh - 234px) * 1.06)); margin: 0 auto; background: white; border: 1px solid var(--line); border-radius: 10px; overflow: hidden; }
  .replay-visuals { padding-bottom: 20px; }
  .replay-visuals > div { min-width: 0; }
  .surface { position: relative; width: 100%; min-width: 0; }
  .surface canvas { display: block; width: 100%; height: 100%; }
  .circuit { aspect-ratio: 1240 / 450; }
  .timing-title { padding: 8px 16px 6px; font-size: 12px; font-weight: 600; line-height: 1.3; color: #263343; }
  .dynamics { aspect-ratio: 1240 / 480; }
  .timing { aspect-ratio: 1240 / 240; }
  .canvas-scroll { overflow-x: auto; }
  .labels { position: absolute; inset: 0; pointer-events: none; }
  .scene-label { position: absolute; white-space: nowrap; line-height: 1.2; }
  .transport { display: flex; flex-wrap: wrap; gap: 10px 12px; align-items: center; padding: 10px 16px; border-top: 1px solid #edf0f3; background: #fcfdfe; }
  .scrub-label { flex: 1; min-width: 130px; }
  .scrub-label input { width: 100%; }
  button, select { font: inherit; font-size: 12px; color: #263343; background: white; border: 1px solid #cbd5df; border-radius: 5px; padding: 8px 12px; cursor: pointer; line-height: 1.25; }
  button:hover { background: #f1f5f8; }
  button.primary { background: #263343; color: white; border-color: #263343; min-width: 65px; }
  button:disabled, select:disabled, input:disabled { opacity: .45; cursor: default; }
  label { font-size: 12px; color: var(--muted); display: flex; align-items: center; gap: 8px; }
  select { padding-right: 22px; }
  input { accent-color: var(--blue); }
  :focus-visible { outline: 2px solid var(--blue); outline-offset: 3px; }
  [data-id="error"] { padding: 18px; color: #a3313b; background: #f9e9eb; border: 1px solid #ebc8cd; border-radius: 8px; margin-bottom: 20px; }
  @container (min-width: 800px) {
    .panel { max-width: max(600px, calc((100svh - 234px) * 1.75)); }
    .replay-visuals {
      display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      grid-template-areas: "circuit circuit" "timings dynamics"; gap: 0 12px;
      padding: 8px 8px 20px;
    }
    .circuit-area { grid-area: circuit; }
    .timings-area { grid-area: timings; display: flex; flex-direction: column; }
    .dynamics-area { grid-area: dynamics; }
    .timings-area .canvas-scroll { flex: 1; display: flex; min-height: 0; }
    .timing { aspect-ratio: auto; }
    .timing-title { padding: 8px 10px 6px; }
  }
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; }
  @media (max-width: 760px) {
    .transport { padding: 10px 12px; }
  }
}
</style>
