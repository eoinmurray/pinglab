---
import { optionalPresentation, imageUrl } from '../../../site/src/lib/pingstore';
interface Props { experiment: string }
const { experiment } = Astro.props;
const selected = await optionalPresentation(experiment);
---
<figure class="l-body" id="lifecycle-replay">
  {selected ? <ei-lifecycle class="ei-recording" data-source={await imageUrl(selected.id, 'lifecycle.json')}>
    <div data-id="error" role="alert" hidden></div>
    <section class="panel" aria-label="Recorded E/I prenatal development and food-learning lifetimes">
      <div class="stats">
        <div><span>Phase</span><strong data-id="phase">—</strong></div>
        <div><span>Encounter</span><strong data-id="encounter">—</strong></div>
        <div><span>Life</span><strong data-id="life">—</strong></div>
        <div><span>Age</span><strong data-id="age">—</strong></div>
        <div><span>Energy</span><strong data-id="energy">—</strong></div>
        <div><span>Deaths</span><strong data-id="deaths">—</strong></div>
      </div>
      <div class="phases" aria-label="Developmental stages">
        <span data-stage="prenatal" role="progressbar" aria-label="Prenatal phase progress" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0">Prenatal <small>internal activity</small></span>
        <span data-stage="juvenile" role="progressbar" aria-label="Juvenile phase progress" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0">Juvenile <small>food learning</small></span>
        <span data-stage="adult" role="progressbar" aria-label="Recorded adult phase progress" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" title="Progress through the recorded adult portion of this life">Adult <small>slower learning</small></span>
      </div>
      <div class="scene-frame"><div data-id="scene" class="scene" role="img" aria-label="Recorded activity of sixteen E cells and four I cells. Prenatal internal drive precedes birth and food encounters. An activity target replaces the food readout before birth; afterwards readout nodes project to predicted energy, with an energy reserve on the right."></div></div>
      <div class="energy-legend" aria-label="Energy bar colours">
        <span><i class="reserve"></i>Energy</span>
        <span><i class="food"></i>Food gain</span>
        <span><i class="metabolic"></i>Metabolic loss</span>
        <span><i class="poison"></i>Poison loss</span>
      </div>
      <div class="transport">
        <button data-id="play" class="primary" disabled>Pause</button>
        <button data-id="restart" disabled>Restart</button>
        <label class="scrub-label"><span class="sr-only">Lifecycle playback position</span><input data-id="scrub" type="range" min="0" max="300" step="0.01" value="0" disabled /></label>
        <label>Speed <select data-id="speed" disabled><option value="1">1×</option><option value="2">2×</option><option value="3" selected>3×</option><option value="4">4×</option><option value="5">5×</option></select></label>
      </div>
    </section>
  </ei-lifecycle> : <p>Replay data unavailable.</p>}
  <figcaption><b>Figure 1.</b> Internal activity shapes the circuit before birth; food learning follows, slowing in adulthood. Brightness shows recorded rates; moving strokes illustrate flow. Death restarts development from the same inherited circuit (seed 7).</figcaption>
</figure>
<script>
  import { mountLifecycle } from './js/lifecycle.js';
  class EILifecycle extends HTMLElement {
    dispose?: () => void;
    async connectedCallback() {
      try {
        const dispose = await mountLifecycle(this);
        if (this.isConnected) this.dispose = dispose;
        else dispose();
      } catch (error) {
        const box = this.querySelector<HTMLElement>('[data-id="error"]');
        if (box) { box.hidden = false; box.textContent = `Replay unavailable: ${error instanceof Error ? error.message : error}`; }
      }
    }
    disconnectedCallback() { this.dispose?.(); }
  }
  if (!customElements.get('ei-lifecycle')) customElements.define('ei-lifecycle', EILifecycle);
</script>
<style>
  figure > ei-lifecycle { display: block; }
  @media (min-width: 1180px) { figure { grid-column: text-start / page-end; display: grid; grid-template-columns: subgrid; } ei-lifecycle, figcaption { grid-column: 1 / -1; } }
</style>
<style is:global>
.ei-recording {
  display: block; color: #263343; font-family: Inter, system-ui, sans-serif;
  --blue: #176d91; --muted: #687787; --line: #dce3e8;
  * { box-sizing: border-box; }
  .panel { width: 100%; margin: 0 auto; background: #fff; border: 1px solid var(--line); border-radius: 10px; overflow: hidden; }
  .transport { display: flex; flex-wrap: wrap; gap: 10px 16px; align-items: center; padding: 12px 16px; background: #fcfdfe; }
  label { font-size: 12px; color: var(--muted); display: flex; align-items: center; gap: 8px; }
  button, select { font: inherit; font-size: 12px; color: #263343; background: #fff; border: 1px solid #cbd5df; border-radius: 5px; padding: 8px 12px; cursor: pointer; line-height: 1.25; }
  button:hover { background: #f1f5f8; }
  button.primary { background: #263343; color: #fff; border-color: #263343; min-width: 65px; }
  button:disabled, select:disabled, input:disabled { opacity: .45; cursor: default; }
  input { accent-color: var(--blue); }
  :focus-visible { outline: 2px solid var(--blue); outline-offset: 3px; }
  .stats { display: flex; flex-wrap: wrap; align-items: baseline; gap: 6px 16px; padding: 8px 16px; background: #fcfdfe; border-bottom: 1px solid #edf0f3; }
  .stats > div { display: inline-flex; align-items: baseline; gap: 6px; min-width: 0; }
  .stats > div + div { border-left: 1px solid var(--line); padding-left: 16px; }
  .stats span { font-size: 10px; color: var(--muted); }
  .stats strong { font-size: 13px; font-weight: 600; font-variant-numeric: tabular-nums; }
  .phases { display: flex; gap: 4px; padding: 6px 16px 2px; }
  .phases > span { position: relative; flex: 1; padding: 4px 8px 6px; font-size: 11px; color: var(--muted); }
  .phases > span::before, .phases > span::after { content: ''; position: absolute; bottom: 0; left: 0; height: 2px; }
  .phases > span::before { width: 100%; background: var(--line); }
  .phases > span::after { width: var(--phase-progress, 0%); background: var(--blue); }
  .phases small { margin-left: 5px; font-size: 10px; font-weight: 400; }
  .phases [data-state="active"] { color: var(--blue); background: #edf5f8; font-weight: 600; }
  .phases [data-state="done"]::after { background: #9eafb9; }
  .scene-frame { padding: 4px 24px; }
  .scene { position: relative; width: 100%; aspect-ratio: 760 / 320; }
  .scene canvas { display: block; width: 100%; height: 100%; }
  .scene-labels { position: absolute; inset: 0; pointer-events: none; }
  .scene-label { position: absolute; white-space: nowrap; line-height: 1.3; }
  .energy-legend { display: flex; flex-wrap: wrap; gap: 8px 18px; padding: 0 20px 4px; font-size: 11px; color: var(--muted); }
  .energy-legend span { display: inline-flex; align-items: center; gap: 5px; }
  .energy-legend i { display: inline-block; width: 9px; height: 9px; border-radius: 2px; }
  .energy-legend .reserve { background: #176d91; }
  .energy-legend .food { background: #27866a; }
  .energy-legend .metabolic { background: #c58a24; }
  .energy-legend .poison { background: #bc3b43; }
  .transport { border-top: 1px solid #edf0f3; }
  .scrub-label { flex: 1; min-width: 130px; }
  .scrub-label input { width: 100%; }
  [data-id="error"] { padding: 18px; color: #a3313b; background: #f9e9eb; }
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; }
  @media (max-width: 600px) {
    .scene-frame { padding: 4px 20px; }
    .scene { aspect-ratio: 700 / 320; }
    .stats { padding: 8px 12px; gap: 6px 10px; }
    .stats > div + div { padding-left: 10px; }
    .stats span { font-size: 9px; }
    .phases { padding: 6px 12px 2px; }
    .phases small { display: none; }
    .energy-legend { padding: 0 12px 4px; }
  }
}
</style>
