new file mode 100644
index 00000000..b8fd4e04
--- /dev/null
+++ b/experiments/exp098.py
@@ -0,0 +1,707 @@
+"""EXP098: prospectively scout and film an AI-to-PING transition.
+
+The runner is intentionally blocked while EXP_SCOUT_PLAN.md remains draft.
+After the user freezes the plan, it searches a bounded local coupling-by-drive
+grid, validates any bracket, and records one continuous input-rate transition.
+"""
+
+from __future__ import annotations
+
+import json
+import sys
+import time
+from dataclasses import replace
+from pathlib import Path
+
+import matplotlib.pyplot as plt
+import numpy as np
+import torch
+from matplotlib import animation
+from scipy.ndimage import gaussian_filter1d
+from scipy.signal import find_peaks, welch
+
+REPO = Path(__file__).resolve().parents[1]
+sys.path.insert(0, str(REPO))
+sys.path.insert(0, str(REPO / "tools" / "snn"))
+sys.path.insert(0, str(Path(__file__).resolve().parent))
+
+from execution import ExecutionSpec, simulate  # noqa: E402
+from tools import snnlang as snn  # noqa: E402, TID251
+
+from helpers import theme  # noqa: E402
+from helpers.cli import parse_meta  # noqa: E402
+from helpers.gamma_frequency import (  # noqa: E402
+    DEFAULT_PING_GAMMA,
+    estimate_gamma_from_raster,
+)
+from helpers.numbers import write_numbers  # noqa: E402
+from helpers.run_dirs import published_run  # noqa: E402
+from helpers.run_id import next_run_id  # noqa: E402
+
+SLUG = "exp098"
+PLAN_PATH = REPO / "artifacts" / "data" / SLUG / "EXP_SCOUT_PLAN.md"
+STATE_PATH = REPO / "artifacts" / "data" / SLUG / "SCIENTIFIC_COLLECTION_STATE.md"
+DT_MS = 0.1
+TRIAL_T_MS = 500.0
+BURN_MS = 100.0
+VIDEO_T_MS = 2_200.0
+TAU_GABA_MS = 2.0
+N_INPUT = 128
+N_E = 80
+N_I = 20
+NETWORK_SEED = 98
+DISCOVERY_SEED = 9800
+VALIDATION_SEEDS = (9801, 9802, 9803)
+VIDEO_SEED = 9899
+COUPLING_MULTIPLIERS = (0.25, 0.5, 0.75, 1.0, 1.25, 1.5, 2.0)
+INPUT_RATES_HZ = (25.0, 40.0, 60.0)
+FREQUENCY_CONFIG = replace(
+    DEFAULT_PING_GAMMA,
+    name="exp098-ping-gamma-v1",
+    band_hz=(5.0, 80.0),
+    burn_ms=BURN_MS,
+    subharmonic_ratio=0.3,
+)
+SCALE = {
+    "dt_ms": DT_MS,
+    "trial_t_ms": TRIAL_T_MS,
+    "video_t_ms": VIDEO_T_MS,
+    "burn_ms": BURN_MS,
+    "n_input": N_INPUT,
+    "n_e": N_E,
+    "n_i": N_I,
+    "tau_gaba_ms": TAU_GABA_MS,
+    "coupling_multipliers": list(COUPLING_MULTIPLIERS),
+    "input_rates_hz": list(INPUT_RATES_HZ),
+    "network_seed": NETWORK_SEED,
+}
+
+
+def require_frozen_plan() -> tuple[str, str]:
+    plan = PLAN_PATH.read_text()
+    state = STATE_PATH.read_text()
+    if "- Frozen;" not in plan or "Status: `ExpScoutPlan`; frozen" not in state:
+        raise SystemExit(
+            "exp098 plan is draft; freeze EXP_SCOUT_PLAN.md and "
+            "SCIENTIFIC_COLLECTION_STATE.md before evidence-bearing execution"
+        )
+    return plan, state
+
+
+def author_network(coupling: float, *, break_e_to_i: bool = False) -> snn.Bundle:
+    """Author one fixed graph; only the shared recurrent multiplier varies."""
+    net = snn.Network(f"exp098_ping_alpha_{coupling:g}", dt=DT_MS * snn.ms)
+    drive = net.input(
+        "drive", shape=("time", "batch", N_INPUT), signal_type="spikes", unit="spike"
+    )
+    with net.group("ping"):
+        e = net.population(
+            "ping_E",
+            size=N_E,
+            neuron=snn.COBA_LIF(
+                tau_mem=20 * snn.ms,
+                capacitance_nf=1.0,
+                leak_us=0.05,
+                resting_mv=-65.0,
+                threshold_mv=-50.0,
+                reset_mv=-65.0,
+                refractory_steps=12,
+                voltage_grad_dampen=80.0,
+                initial_voltage_mv=-65.0,
+            ),
+        )
+        i = net.population(
+            "ping_I",
+            size=N_I,
+            neuron=snn.COBA_LIF(
+                tau_mem=5 * snn.ms,
+                capacitance_nf=0.5,
+                leak_us=0.1,
+                resting_mv=-65.0,
+                threshold_mv=-50.0,
+                reset_mv=-65.0,
+                refractory_steps=6,
+                voltage_grad_dampen=80.0,
+                initial_voltage_mv=-65.0,
+            ),
+        )
+        e_to_i = 0.0 if break_e_to_i else coupling
+        net.connect(
+            e.spikes,
+            i.excitatory,
+            name="ping_E_to_I",
+            synapse=snn.AMPA(tau=2 * snn.ms),
+            weight=snn.Normal(0.5 * e_to_i, 0.05 * e_to_i),
+            constraint=snn.NonNegative(),
+            connection="recurrent",
+            delay=0.1 * snn.ms,
+        )
+        net.connect(
+            i.spikes,
+            e.inhibitory,
+            name="ping_I_to_E",
+            synapse=snn.GABA(tau=TAU_GABA_MS * snn.ms),
+            weight=snn.Normal(1.0 * coupling, 0.1 * coupling),
+            constraint=snn.NonNegative(),
+            connection="recurrent",
+            delay=0.1 * snn.ms,
+        )
+        net.connect(
+            drive,
+            e.excitatory,
+            name="ping_input",
+            synapse=snn.AMPA(tau=2 * snn.ms),
+            weight=snn.Normal(0.2, 0.03),
+            constraint=snn.NonNegative(),
+        )
+    net.expose(e.spikes, i.spikes, name="population")
+    return snn.compile(net, target="tools/snn")
+
+
+def make_inputs(rate_hz: float, seed: int, *, t_ms: float = TRIAL_T_MS) -> np.ndarray:
+    rates = np.full(round(t_ms / DT_MS), rate_hz, dtype=float)
+    return make_scheduled_inputs(rates, seed=seed)
+
+
+def input_rate_schedule(ai_rate_hz: float, ping_rate_hz: float) -> np.ndarray:
+    t = np.arange(round(VIDEO_T_MS / DT_MS)) * DT_MS
+    rates = np.full_like(t, ai_rate_hz, dtype=float)
+    up = (t >= 300.0) & (t < 900.0)
+    rates[up] = ai_rate_hz + (ping_rate_hz - ai_rate_hz) * (t[up] - 300.0) / 600.0
+    rates[(t >= 900.0) & (t < 1_300.0)] = ping_rate_hz
+    down = (t >= 1_300.0) & (t < 1_900.0)
+    rates[down] = (
+        ping_rate_hz - (ping_rate_hz - ai_rate_hz) * (t[down] - 1_300.0) / 600.0
+    )
+    return rates
+
+
+def make_scheduled_inputs(rates_hz: np.ndarray, *, seed: int) -> np.ndarray:
+    rng = np.random.default_rng(seed)
+    probability = rates_hz[:, None] * DT_MS / 1_000.0
+    spikes = rng.random((len(rates_hz), N_INPUT), dtype=np.float32) < probability
+    return spikes[:, None, :].astype(np.uint8)
+
+
+def recording_arrays(result) -> dict[str, np.ndarray]:
+    return {
+        "e": result.recordings["population_0"].cpu().numpy().astype(np.uint8),
+        "i": result.recordings["population_1"].cpu().numpy().astype(np.uint8),
+        "v_e": result.recordings["ping_E.voltage"].cpu().numpy(),
+        "v_i": result.recordings["ping_I.voltage"].cpu().numpy(),
+        "g_e": result.recordings["ping_E_to_I.conductance"].cpu().numpy(),
+        "g_i": result.recordings["ping_I_to_E.conductance"].cpu().numpy(),
+    }
+
+
+def simulate_graph(
+    bundle: snn.Bundle, inputs: np.ndarray, *, full: bool = False
+) -> dict[str, np.ndarray]:
+    result = simulate(
+        ExecutionSpec(
+        kind="simulate",
+        executor="graph",
+        graph=bundle.graph,
+        inputs={"drive": torch.from_numpy(inputs).float()},
+        seed=NETWORK_SEED,
+        recording="full" if full else "observables",
+    )
+    )
+    if full:
+        return recording_arrays(result)
+    return {
+        "e": result.recordings["population_0"].cpu().numpy().astype(np.uint8),
+        "i": result.recordings["population_1"].cpu().numpy().astype(np.uint8),
+    }
+
+
+def detected_peaks(e_spikes: np.ndarray, *, burn_ms: float = BURN_MS) -> np.ndarray:
+    fraction = e_spikes[:, 0].mean(axis=1)
+    smooth = gaussian_filter1d(fraction.astype(float), sigma=5.0)
+    peaks, _ = find_peaks(
+        smooth,
+        distance=round(12.0 / DT_MS),
+        prominence=2.0 / N_E,
+    )
+    return peaks[peaks >= round(burn_ms / DT_MS)]
+
+
+def median_isi_cv(e_spikes: np.ndarray, *, burn_ms: float = BURN_MS) -> float | None:
+    burn = round(burn_ms / DT_MS)
+    values = []
+    for cell in range(e_spikes.shape[2]):
+        times = np.flatnonzero(e_spikes[burn:, 0, cell]) * DT_MS
+        intervals = np.diff(times)
+        if len(intervals) >= 3 and intervals.mean() > 0:
+            values.append(float(intervals.std(ddof=1) / intervals.mean()))
+    return None if not values else float(np.median(values))
+
+
+def mean_pairwise_correlation(
+    e_spikes: np.ndarray, *, burn_ms: float = BURN_MS
+) -> float | None:
+    burn = round(burn_ms / DT_MS)
+    sample = e_spikes[burn:, 0, np.linspace(0, e_spikes.shape[2] - 1, 20, dtype=int)]
+    bin_steps = round(5.0 / DT_MS)
+    usable = len(sample) // bin_steps * bin_steps
+    if usable == 0:
+        return None
+    counts = sample[:usable].reshape(-1, bin_steps, sample.shape[1]).sum(axis=1)
+    keep = counts.std(axis=0) > 0
+    if keep.sum() < 2:
+        return None
+    matrix = np.corrcoef(counts[:, keep], rowvar=False)
+    return float(matrix[np.triu_indices_from(matrix, k=1)].mean())
+
+
+def rhythmicity_contrast(
+    e_spikes: np.ndarray, *, burn_ms: float = BURN_MS
+) -> float | None:
+    count = e_spikes[round(burn_ms / DT_MS) :, 0].mean(axis=1)
+    bin_steps = round(1.0 / DT_MS)
+    usable = len(count) // bin_steps * bin_steps
+    if usable < 30 * bin_steps:
+        return None
+    series = count[:usable].reshape(-1, bin_steps).sum(axis=1)
+    series -= series.mean()
+    ac = np.correlate(series, series, mode="full")[len(series) - 1 :]
+    if ac[0] <= 0:
+        return None
+    ac /= ac[0]
+    peaks, _ = find_peaks(ac[2:100])
+    if not len(peaks):
+        return 0.0
+    p = int(peaks[0] + 2)
+    trough = float(ac[1:p].min())
+    lobe = float(ac[p])
+    denominator = lobe + trough
+    return (
+        0.0
+        if denominator <= 0
+        else float(np.clip((lobe - trough) / denominator, 0.0, 1.0))
+    )
+
+
+def condition_metrics(
+    arrays: dict[str, np.ndarray], rate_hz: float, coupling: float
+) -> dict:
+    e, i = arrays["e"], arrays["i"]
+    burn = round(BURN_MS / DT_MS)
+    duration_s = (e.shape[0] * DT_MS - BURN_MS) / 1_000.0
+    gamma = estimate_gamma_from_raster(e, dt_ms=DT_MS, config=FREQUENCY_CONFIG)
+    resolved = [trial.frequency_hz for trial in gamma.trials if trial.resolved]
+    row = {
+        "coupling": coupling,
+        "input_rate_hz": rate_hz,
+        "e_rate_hz": float(e[burn:].sum() / e.shape[1] / N_E / duration_s),
+        "i_rate_hz": float(i[burn:].sum() / i.shape[1] / N_I / duration_s),
+        "isi_cv": median_isi_cv(e),
+        "pairwise_correlation": mean_pairwise_correlation(e),
+        "complete_cycles": max(0, len(detected_peaks(e)) - 1),
+        "rhythmicity": rhythmicity_contrast(e),
+        "gamma_frequency_hz": None if not resolved else float(np.median(resolved)),
+    }
+    row["state"] = classify_condition(row)
+    return row
+
+
+def classify_condition(metrics: dict) -> str:
+    active = metrics["e_rate_hz"] >= 1.0 and metrics["i_rate_hz"] >= 1.0
+    if not active:
+        return "inactive"
+    frequency = metrics.get("gamma_frequency_hz")
+    ping = (
+        metrics.get("complete_cycles", 0) >= 3
+        and (metrics.get("rhythmicity") or 0.0) >= 0.5
+        and frequency is not None
+        and 30.0 <= frequency <= 80.0
+    )
+    if ping:
+        return "PING"
+    cv = metrics.get("isi_cv")
+    corr = metrics.get("pairwise_correlation")
+    if cv is not None and cv >= 0.75 and corr is not None and corr < 0.05:
+        return "AI"
+    return "transitional"
+
+
+def select_transition(rows: list[dict]) -> dict | None:
+    for coupling in COUPLING_MULTIPLIERS:
+        group = sorted(
+            (row for row in rows if row["coupling"] == coupling),
+            key=lambda row: row["input_rate_hz"],
+        )
+        for ai in group:
+            if ai["state"] != "AI":
+                continue
+            for ping in group:
+                if (
+                    ping["state"] == "PING"
+                    and ping["input_rate_hz"] > ai["input_rate_hz"]
+                ):
+                    return {
+                        "coupling": coupling,
+                        "ai_rate_hz": ai["input_rate_hz"],
+                        "ping_rate_hz": ping["input_rate_hz"],
+                    }
+    return None
+
+
+def rolling_metrics(
+    e: np.ndarray, sample_steps: np.ndarray
+) -> dict[str, list[float | None]]:
+    window = round(300.0 / DT_MS)
+    output = {
+        "isi_cv": [],
+        "pairwise_correlation": [],
+        "gamma_frequency_hz": [],
+        "gamma_power_fraction": [],
+    }
+    for right in sample_steps:
+        left = max(0, int(right) - window)
+        segment = e[left : int(right) + 1]
+        if len(segment) < round(100.0 / DT_MS):
+            for key in output:
+                output[key].append(None)
+            continue
+        output["isi_cv"].append(median_isi_cv(segment, burn_ms=0.0))
+        output["pairwise_correlation"].append(
+            mean_pairwise_correlation(segment, burn_ms=0.0)
+        )
+        signal = segment[:, 0].mean(axis=1)
+        frequencies, power = welch(
+            signal, fs=1_000.0 / DT_MS, nperseg=min(len(signal), 2048)
+        )
+        band = (frequencies >= 30.0) & (frequencies <= 80.0)
+        total = (frequencies >= 5.0) & (frequencies <= 80.0)
+        if not band.any() or power[total].sum() <= 0:
+            output["gamma_frequency_hz"].append(None)
+            output["gamma_power_fraction"].append(None)
+        else:
+            index = np.flatnonzero(band)[np.argmax(power[band])]
+            output["gamma_frequency_hz"].append(float(frequencies[index]))
+            output["gamma_power_fraction"].append(
+                float(power[band].sum() / power[total].sum())
+            )
+    return output
+
+
+def build_video_state(
+    arrays: dict[str, np.ndarray], inputs: np.ndarray, rates: np.ndarray
+) -> dict:
+    edges = np.linspace(0, len(rates), 301, dtype=int)
+    sample = edges[:-1]
+    input_cells = np.linspace(0, N_INPUT - 1, 24, dtype=int)
+    e_cells = np.linspace(0, N_E - 1, 40, dtype=int)
+    i_cells = np.linspace(0, N_I - 1, 20, dtype=int)
+
+    def events(spikes: np.ndarray, cells: np.ndarray) -> tuple[list[float], list[int]]:
+        steps, rows = np.nonzero(spikes[:, 0, cells])
+        return (steps * DT_MS).round(3).tolist(), rows.astype(int).tolist()
+
+    def rates_per_bin(spikes: np.ndarray) -> list[float]:
+        values = []
+        for left, right in zip(edges[:-1], edges[1:]):
+            seconds = max((right - left) * DT_MS / 1_000.0, DT_MS / 1_000.0)
+            values.append(
+                float(
+                    spikes[left:right].sum()
+                    / spikes.shape[1]
+                    / spikes.shape[2]
+                    / seconds
+                )
+            )
+        return values
+
+    input_t, input_r = events(inputs, input_cells)
+    e_t, e_r = events(arrays["e"], e_cells)
+    i_t, i_r = events(arrays["i"], i_cells)
+    return {
+        "time_ms": (sample * DT_MS).round(3).tolist(),
+        "command_rate_hz": rates[sample].round(4).tolist(),
+        "input_rate_hz": rates_per_bin(inputs),
+        "e_rate_hz": rates_per_bin(arrays["e"]),
+        "i_rate_hz": rates_per_bin(arrays["i"]),
+        "g_e": arrays["g_e"].mean(axis=(1, 2))[sample].round(8).tolist(),
+        "g_i": arrays["g_i"].mean(axis=(1, 2))[sample].round(8).tolist(),
+        "input_events": {"time_ms": input_t, "row": input_r, "n": len(input_cells)},
+        "e_events": {"time_ms": e_t, "row": e_r, "n": len(e_cells)},
+        "i_events": {"time_ms": i_t, "row": i_r, "n": len(i_cells)},
+        "transition_metrics": rolling_metrics(arrays["e"], sample),
+        "seed": VIDEO_SEED,
+    }
+
+
+def render_video(state: dict, out: Path, poster: Path) -> None:
+    theme.apply()
+    t = np.asarray(state["time_ms"])
+    command = np.asarray(state["command_rate_hz"])
+    ge, gi = np.asarray(state["g_e"]), np.asarray(state["g_i"])
+    er, ir = np.asarray(state["e_rate_hz"]), np.asarray(state["i_rate_hz"])
+    metrics = state["transition_metrics"]
+    fig, axes = plt.subplots(2, 2, figsize=(12.8, 7.2), facecolor="#f4f7f9")
+    ax_input, ax_raster, ax_phase, ax_metrics = axes.flat
+    fig.suptitle(
+        "Simulation result · stochastic drive to collective PING", fontweight="bold"
+    )
+
+    inp = state["input_events"]
+    ax_input.scatter(
+        inp["time_ms"], inp["row"], marker="|", s=8, color=theme.GREY_MID, alpha=0.65
+    )
+    ax_input.plot(
+        t,
+        command / max(command.max(), 1.0) * (inp["n"] - 1),
+        ls="--",
+        color=theme.INK_BLACK,
+        lw=1.0,
+    )
+    ax_input.set(
+        title="Poisson input · dashed command",
+        ylabel="24 sampled channels",
+        xlim=(0, VIDEO_T_MS),
+    )
+
+    ev, iv = state["e_events"], state["i_events"]
+    ax_raster.scatter(
+        ev["time_ms"], ev["row"], marker="|", s=9, color=theme.DEEP_RED, alpha=0.72
+    )
+    ax_raster.scatter(
+        iv["time_ms"],
+        np.asarray(iv["row"]) + ev["n"] + 3,
+        marker="|",
+        s=9,
+        color=theme.INK_BLACK,
+        alpha=0.72,
+    )
+    ax_raster.set(
+        title="Population activity", ylabel="40 E · 20 I", xlim=(0, VIDEO_T_MS)
+    )
+
+    ax_phase.plot(ge, gi, color=theme.GREY_MID, lw=0.8, alpha=0.35)
+    (trail,) = ax_phase.plot([], [], color=theme.DEEP_RED, lw=2.0)
+    (dot,) = ax_phase.plot([ge[0]], [gi[0]], "o", color=theme.INK_BLACK)
+    ax_phase.set(
+        title="Recurrent conductance state", xlabel="$g_E$ (µS)", ylabel="$g_I$ (µS)"
+    )
+
+    ax_metrics.plot(
+        t, command, ls="--", color=theme.GREY_MID, label="command Hz/channel"
+    )
+    ax_metrics.plot(t, er, color=theme.DEEP_RED, label="E rate")
+    ax_metrics.plot(t, ir, color=theme.INK_BLACK, label="I rate")
+    ax_metrics.set(
+        title="Command and population rates",
+        xlabel="biological time (ms)",
+        ylabel="Hz",
+        xlim=(0, VIDEO_T_MS),
+    )
+    ax_metrics.legend(frameon=False, fontsize=8)
+    cursors = [
+        axis.axvline(0, color=theme.DEEP_RED, lw=1.2)
+        for axis in (ax_input, ax_raster, ax_metrics)
+    ]
+    readout = fig.text(0.5, 0.025, "", ha="center", fontsize=9)
+    for axis in axes.flat:
+        axis.spines[["top", "right"]].set_visible(False)
+    fig.tight_layout(rect=(0, 0.06, 1, 0.94))
+
+    def update(frame: int):
+        for cursor in cursors:
+            cursor.set_xdata([t[frame], t[frame]])
+        left = max(0, frame - 50)
+        trail.set_data(ge[left : frame + 1], gi[left : frame + 1])
+        dot.set_data([ge[frame]], [gi[frame]])
+        cv = metrics["isi_cv"][frame]
+        corr = metrics["pairwise_correlation"][frame]
+        freq = metrics["gamma_frequency_hz"][frame]
+        power = metrics["gamma_power_fraction"][frame]
+        readout.set_text(
+            f"seed {state['seed']} · biological time {t[frame]:.1f} ms · command {command[frame]:.1f} Hz/channel · "
+            f"trailing 300 ms: CV {'—' if cv is None else f'{cv:.2f}'}, corr {'—' if corr is None else f'{corr:.3f}'}, "
+            f"gamma {'unresolved' if freq is None else f'{freq:.1f} Hz'}, power {'—' if power is None else f'{power:.2f}'} · playback 30 fps"
+        )
+        return [*cursors, trail, dot, readout]
+
+    update(0)
+    fig.savefig(poster, dpi=150, facecolor=fig.get_facecolor())
+    movie = animation.FuncAnimation(
+        fig, update, frames=len(t), interval=1000 / 30, blit=False
+    )
+    movie.save(
+        out,
+        writer=animation.FFMpegWriter(
+            fps=30,
+            codec="libx264",
+            bitrate=2400,
+            extra_args=["-pix_fmt", "yuv420p", "-movflags", "+faststart"],
+        ),
+        dpi=120,
+    )
+    plt.close(fig)
+
+
+def plot_scan(rows: list[dict], out: Path) -> None:
+    theme.apply()
+    fig, ax = plt.subplots(figsize=(7.0, 4.2))
+    colours = {
+        "AI": "#5d7c8c",
+        "PING": theme.DEEP_RED,
+        "transitional": "#c49a46",
+        "inactive": theme.GREY_MID,
+    }
+    for row in rows:
+        ax.scatter(
+            row["input_rate_hz"],
+            row["coupling"],
+            s=85,
+            color=colours[row["state"]],
+            edgecolor="white",
+            linewidth=0.7,
+        )
+        ax.text(
+            row["input_rate_hz"],
+            row["coupling"],
+            row["state"],
+            ha="center",
+            va="bottom",
+            fontsize=7,
+        )
+    ax.set(
+        xlabel="input rate per channel (Hz)",
+        ylabel="shared recurrent multiplier",
+        title="Measured transition search",
+    )
+    ax.spines[["top", "right"]].set_visible(False)
+    fig.tight_layout()
+    fig.savefig(out, dpi=220)
+    plt.close(fig)
+
+
+def main() -> None:
+    meta = parse_meta(sys.argv)
+    if meta.plot_only:
+        raise SystemExit(
+            "exp098 has no result bundle to replot before its first frozen execution"
+        )
+    plan_text, state_text = require_frozen_plan()
+    started = time.monotonic()
+    run_id = next_run_id(SLUG)
+    with published_run(SLUG, run_id, scale=SCALE) as (scratch, staging):
+        rows = []
+        bundles: dict[float, snn.Bundle] = {}
+        for coupling in COUPLING_MULTIPLIERS:
+            bundle = author_network(coupling)
+            bundles[coupling] = bundle
+            for rate in INPUT_RATES_HZ:
+                arrays = simulate_graph(bundle, make_inputs(rate, DISCOVERY_SEED))
+                rows.append(condition_metrics(arrays, rate, coupling))
+        transition = select_transition(rows)
+        plot_scan(rows, staging / "transition_scan.svg")
+        result: dict = {
+            "search": rows,
+            "transition": transition,
+            "video_status": "not-run",
+        }
+        if transition is not None:
+            coupling = transition["coupling"]
+            bundle = bundles[coupling]
+            validation = []
+            control = author_network(coupling, break_e_to_i=True)
+            for seed in VALIDATION_SEEDS:
+                for label, rate in (
+                    ("AI", transition["ai_rate_hz"]),
+                    ("PING", transition["ping_rate_hz"]),
+                ):
+                    validation.append(
+                        {
+                            "expected": label,
+                            "seed": seed,
+                            **condition_metrics(
+                                simulate_graph(bundle, make_inputs(rate, seed)),
+                                rate,
+                                coupling,
+                            ),
+                        }
+                    )
+                validation.append(
+                    {
+                        "expected": "broken-loop",
+                        "seed": seed,
+                        **condition_metrics(
+                            simulate_graph(
+                                control, make_inputs(transition["ping_rate_hz"], seed)
+                            ),
+                            transition["ping_rate_hz"],
+                            coupling,
+                        ),
+                    }
+                )
+            ai_pass = (
+                sum(
+                    row["state"] == "AI"
+                    for row in validation
+                    if row["expected"] == "AI"
+                )
+                >= 2
+            )
+            ping_pass = all(
+                row["state"] == "PING"
+                for row in validation
+                if row["expected"] == "PING"
+            )
+            control_pass = all(
+                row["state"] != "PING"
+                for row in validation
+                if row["expected"] == "broken-loop"
+            )
+            result["validation"] = validation
+            result["validation_gate"] = {
+                "ai": ai_pass,
+                "ping": ping_pass,
+                "broken_loop": control_pass,
+            }
+            if ai_pass and ping_pass and control_pass:
+                rates = input_rate_schedule(
+                    transition["ai_rate_hz"], transition["ping_rate_hz"]
+                )
+                inputs = make_scheduled_inputs(rates, seed=VIDEO_SEED)
+                arrays = simulate_graph(bundle, inputs, full=True)
+                state = build_video_state(arrays, inputs, rates)
+                render_video(
+                    state, staging / "ai_to_ping.mp4", staging / "ai_to_ping_poster.png"
+                )
+                (staging / "video_state.json").write_text(
+                    json.dumps(state, separators=(",", ":")) + "\n"
+                )
+                np.savez_compressed(
+                    scratch / "video_recordings.npz",
+                    **arrays,
+                    inputs=inputs,
+                    command_rate_hz=rates,
+                )
+                result["video_status"] = "complete"
+            bundle.write(staging / "network.bundle", visualise=True)
+        (staging / "protocol.json").write_text(json.dumps(SCALE, indent=2) + "\n")
+        (staging / "EXP_SCOUT_PLAN.md").write_text(plan_text)
+        (staging / "SCIENTIFIC_COLLECTION_STATE.md").write_text(
+            state_text.replace(
+                "Awaiting plan review and freeze.",
+                f"Frozen plan executed locally as `{run_id}`; evidence awaits user review.",
+            )
+        )
+        write_numbers(
+            staging,
+            run_id=run_id,
+            duration_s=time.monotonic() - started,
+            payload={
+                "question": "Can stochastic drive move one fixed SNNLANG circuit from AI firing to PING?",
+                "config": SCALE,
+                "results": result,
+            },
+        )
+    print(f"exp098 complete: {run_id}")
+
+
+if __name__ == "__main__":
+    main()

