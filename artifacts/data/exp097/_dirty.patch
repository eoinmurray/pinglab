+from __future__ import annotations
+
+import numpy as np
+from experiments import exp098
+
+
+def test_search_grid_and_budget_are_frozen_in_code() -> None:
+    assert exp098.COUPLING_MULTIPLIERS == (0.25, 0.5, 0.75, 1.0, 1.25, 1.5, 2.0)
+    assert exp098.INPUT_RATES_HZ == (25.0, 40.0, 60.0)
+    assert exp098.N_E == 80
+    assert exp098.N_I == 20
+
+
+def test_rate_schedule_has_holds_and_reversible_ramps() -> None:
+    rates = exp098.input_rate_schedule(25.0, 60.0)
+    assert len(rates) == round(exp098.VIDEO_T_MS / exp098.DT_MS)
+    assert np.all(rates[: round(300 / exp098.DT_MS)] == 25.0)
+    assert rates[round(900 / exp098.DT_MS)] == 60.0
+    assert rates[-1] == 25.0
+    assert np.all(
+        np.diff(rates[round(300 / exp098.DT_MS) : round(900 / exp098.DT_MS) + 1]) >= 0
+    )
+    assert np.all(
+        np.diff(rates[round(1300 / exp098.DT_MS) : round(1900 / exp098.DT_MS) + 1]) <= 0
+    )
+
+
+def test_input_schedule_is_seeded_and_has_no_periodic_template() -> None:
+    rates = exp098.input_rate_schedule(25.0, 60.0)
+    first = exp098.make_scheduled_inputs(rates, seed=exp098.VIDEO_SEED)
+    second = exp098.make_scheduled_inputs(rates, seed=exp098.VIDEO_SEED)
+    assert first.shape == (len(rates), 1, exp098.N_INPUT)
+    assert np.array_equal(first, second)
+    assert set(np.unique(first)).issubset({0, 1})
+
+
+def test_classification_requires_cycles_not_spectrum_alone() -> None:
+    spectral_only = {
+        "e_rate_hz": 8.0,
+        "i_rate_hz": 15.0,
+        "isi_cv": 0.5,
+        "pairwise_correlation": 0.2,
+        "complete_cycles": 0,
+        "rhythmicity": 0.8,
+        "gamma_frequency_hz": 42.0,
+    }
+    assert exp098.classify_condition(spectral_only) == "transitional"
+    ping = {**spectral_only, "complete_cycles": 4}
+    assert exp098.classify_condition(ping) == "PING"
+
+
+def test_transition_selection_requires_one_fixed_coupling() -> None:
+    rows = [
+        {"coupling": 0.5, "input_rate_hz": 25.0, "state": "AI"},
+        {"coupling": 0.5, "input_rate_hz": 60.0, "state": "PING"},
+        {"coupling": 1.0, "input_rate_hz": 25.0, "state": "PING"},
+    ]
+    assert exp098.select_transition(rows) == {
+        "coupling": 0.5,
+        "ai_rate_hz": 25.0,
+        "ping_rate_hz": 60.0,
+    }
