+
+        event_counts = plot_rasters(
+            input_spikes, sim_dir / "rasters.npz", figures / "rasters.png"
+        )
+        metrics = json.loads((sim_dir / "metrics.json").read_text())
+        graph = bundle.graph
+        total_input = int(input_spikes.sum())
+        realised_input_rate = total_input / (
